:: Achievements Init [script]
/* hint = spoiler-light nudge shown under "???" while the achievement is locked */
setup.achievements = {
	workbench_find:       { icon: '🔨', name: '4 Planks in a Square',              desc: 'Find a workbench while exploring.',
	                        hint: 'Wandering the wasteland might turn up something to craft on.' },
	strength_25:          { icon: '💪', name: 'Trials of Hercules',                 desc: 'Reach strength 25.',
	                        hint: 'Every fight you win leaves you a little stronger. Keep brawling.' },
	drugs_buy:            { icon: '💊', name: 'Hi-C',                               desc: 'Buy the suspicious drugs from the gym locker room.',
	                        hint: 'Where people sweat, somebody is selling something they should not.' },
	paul_bunyon:          { icon: '🪓', name: 'Paul Bunyon',                        desc: 'Buy an axe and sell 100 wood to the old man in a single transaction.',
	                        hint: "A lumberjack's dream deal: the right tool and a mountain of timber, all at once." },
	milk_slave:           { icon: '🥛', name: 'Local Creamery',                     desc: "Milk a slave using the old man's breast pump.",
	                        hint: 'The old man sells a gadget meant for a very particular kind of dairy work.' },
	shower_fuck:          { icon: '🚿', name: 'Rubba Dub Dub',                      desc: 'Build the hot shower and fuck someone in it.',
	                        hint: 'A cabin upgrade and a bit of company make bath time a lot more fun.' },
	merchant_venice:      { icon: '💅', name: 'Merchant of Venice',                  desc: 'Sell a slave after improving their appearance.',
	                        hint: 'Presentation sells. Spruce up the merchandise before it goes on the block.' },
	knife_fight_win:      { icon: '🔪', name: "That's Not a Knife",                 desc: 'Carry a knife and win a fight.',
	                        hint: 'Be carrying something sharp the next time a fight goes your way.' },
	gun_find:             { icon: '🔫', name: 'Pumped Up Kicks',                    desc: 'Find a gun while exploring.',
	                        hint: "Solving other people's problems can pay off in firepower." },
	feast_of_kings:       { icon: '🍖', name: 'The Feast of Kings',                 desc: 'Buy 100 food from the old man in a single transaction.',
	                        hint: 'Order enough food to feed an army, and do it in one go.' },
	slave_release_50rel:  { icon: '❤️', name: 'If You Love Them Set Them Free',    desc: 'Release a slave with 50 or more relationship.',
	                        hint: 'Freedom may be the kindest thing to give someone who has grown fond of you.' },
	slave_to_guest:       { icon: '🏠', name: "I Can't Quit You",                   desc: 'Move a slave to the guest house.',
	                        hint: 'Someone from the basement might deserve a better place to stay.' },
	slave_companion:      { icon: '🤝', name: 'Buddy System',                       desc: 'Make a former slave a companion.',
	                        hint: 'Someone from the basement might make a decent travel partner.' },
	companion_fight_win:  { icon: '⚔️', name: 'Back to Back',                      desc: 'Win a fight with a companion at your side.',
	                        hint: 'Do not fight alone. Bring backup.' },
	zombie_horny:         { icon: '🧟', name: "Don't Stick Your Dick In That",      desc: 'Find the horny zombie while exploring.',
	                        hint: 'Not every undead out there is hungry for brains.' }
};
