# Store every text file with LF line endings, whatever the committer's OS or core.autocrlf setting,
# and check them out with LF too.
* text=auto eol=lf

# Binary files: never convert or diff as text
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.mp3  binary
*.mp4  binary
*.webm binary
*.ogg  binary
*.woff binary
*.woff2 binary
*.ttf  binary
