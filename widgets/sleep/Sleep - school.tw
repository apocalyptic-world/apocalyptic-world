:: Sleep - school [widget]

<<widget sleepSchool>>
    <<set _skillJobMapping = {
        'gardener': 'garden', 
        'cook': 'kitchen',
        'doctor': 'hospital',
        'teacher': 'school',
        'woodcraft': 'forest',
        'shopkeeper': 'shop'
    }>>

    <<set _hasTeacher = (setup.getPersonsForLocation($guests, 'school') ?? []).length>>
    <<if _hasTeacher>>

    	<<set _teacherFiltered = setup.filterNPCs($guests, { assignedTo: 'school'})>>
	    <<set _teachers = Object.values(_teacherFiltered).flat()>>
	    <<set _teacher = $guests[_teachers[0]] ?? null>>

        <<for _nurseryI, _nursery range $nursery>>
            <<set _age = setup.getAge(_nursery)>>
            <<if _age < 5>>
                <<continue>>
            <</if>>

            <<set _learnWhat = _nursery.teach ?? 'random'>>
            <<if _learnWhat == 'random'>>
                <<set _learnWhat = either(...Object.keys(_skillJobMapping))>>
            <</if>>

            <<if _teacher && (_teacher.skills ?? []).includes(_learnWhat)>>
                <<set _learnChance = 60>>
            <<else>>
                <<set _learnChance = 40>>
            <</if>>

            <<if setup.percentageChance(_learnChance)>>
                <<set _skillJob = _skillJobMapping[_learnWhat]>>
                <<set _nursery.stats ??= {}>>
                <<set _nursery.stats[_skillJob] ??= 0>>
                <<set _nursery.stats[_skillJob]++>>

                <<if (_nursery.teachAdvStudy ?? 0) > 0 >>
	                <<set _nursery.stats[_skillJob] += randomInteger(1,3) >>
                <</if>>

            <</if>>

            <<if (_nursery.teachAdvStudy ?? 0) > 0 >>
                <<set _nursery.teachAdvStudy-->>
            <</if>>

        <</for>>
    <</if>>

    /* Anyone at 100+ learns the skill, including children the player tutored past it today.
       Proud parents get +5 happy and the teacher's commendation +3. */
    <<run setup.nurseryHelp.graduate(_hasTeacher ? _teacher : null)>>

    /* Evening school: adult guests and slaves (see setup.eveningSchool.nightlyLearning) */
    <<run setup.eveningSchool.nightlyLearning()>>
<</widget>>
