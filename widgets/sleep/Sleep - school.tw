:: Sleep - school [widget]

<<widget sleepSchool>>
    <<set _skillJobMapping = {
        'gardener': 'garden', 
        'cook': 'kitchen',
        'doctor': 'hospital',
        'teacher': 'school',
        'woodcraft': 'forest',
        'shopkeeper': 'shop'
    }>>

    <<set _hasTeacher = (setup.getPersonsForLocation($guests, 'school') ?? []).length>>
    <<if _hasTeacher>>

    	<<set _teacherFiltered = setup.filterNPCs($guests, { assignedTo: 'school'})>>
	    <<set _teachers = Object.values(_teacherFiltered).flat()>>
	    <<set _teacher = $guests[_teachers[0]] ?? null>>

        <<for _nurseryI, _nursery range $nursery>>
            <<set _age = setup.getAge(_nursery)>>
            <<if _age < 5>>
                <<continue>>
            <</if>>

            <<set _learnWhat = _nursery.teach ?? 'random'>>
            <<if _learnWhat == 'random'>>
                <<set _learnWhat = either(...Object.keys(_skillJobMapping))>>
            <</if>>

            <<if _teacher && (_teacher.skills ?? []).includes(_learnWhat)>>
                <<set _learnChance = 60>>
            <<else>>
                <<set _learnChance = 40>>
            <</if>>

            <<if setup.percentageChance(_learnChance)>>
                <<set _skillJob = _skillJobMapping[_learnWhat]>>
                <<set _nursery.stats ??= {}>>
                <<set _nursery.stats[_skillJob] ??= 0>>
                <<set _nursery.stats[_skillJob]++>>

                <<if (_nursery.teachAdvStudy ?? 0) > 0 >>
	                <<set _nursery.stats[_skillJob] += randomInteger(1,3) >>
                <</if>>

                <<if (_nursery.stats[_skillJob] ?? 0) >= 100 && !(_nursery.skills ?? []).includes(_learnWhat)>>
                    <<run _nursery.skills.push(_learnWhat)>>
                    <<set _proudParents = []>>
                    <<set _motherNpc = (_nursery.family?.mother && _nursery.family.mother !== 'mc') ? setup.getNpcById(_nursery.family.mother) : null>>
                    <<set _fatherNpc = (_nursery.family?.father && _nursery.family.father !== 'mc') ? setup.getNpcById(_nursery.family.father) : null>>
                    <<if _motherNpc>>
                        <<set _motherNpc.happy = Math.min(100, (_motherNpc.happy ?? 0) + 5)>>
                        <<run _proudParents.push(_motherNpc.name)>>
                    <</if>>
                    <<if _fatherNpc>>
                        <<set _fatherNpc.happy = Math.min(100, (_fatherNpc.happy ?? 0) + 5)>>
                        <<run _proudParents.push(_fatherNpc.name)>>
                    <</if>>
                    <<set _proudText = _proudParents.length === 1 ? '. ' + _proudParents[0] + ' is very proud!' : _proudParents.length >= 2 ? '. ' + _proudParents.join(' and ') + ' are very proud!' : ''>>
                    <<run setup.sleepMessages.addJob('<span class="skill">' + _nursery.name + ' learned the ' + _learnWhat + ' skill' + _proudText + '</span>', 'school')>>
                <</if>>
            <</if>>

            <<if (_nursery.teachAdvStudy ?? 0) > 0 >>
                <<set _nursery.teachAdvStudy-->>
            <</if>>

        <</for>>
    <</if>>
<</widget>>
