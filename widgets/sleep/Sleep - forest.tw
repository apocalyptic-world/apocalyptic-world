:: sleepForest [include]

<<if typeof _npc.stats['forest'] === 'undefined'>>
    <<set _npc.stats['forest'] = 0>>
<</if>>
<<set _npc.stats['forest']++>>
<<if (_npc.skills ?? []).includes('teacher') && setup.percentageChance(30)>>
	<<set _npc.stats['forest']++>>
<</if>>
<<set _npc.stats['forest'] += setup.personality.learnBonus(_npc)>>

// Learn skill
<<if _npc.stats['forest'] > 100 && !(_npc.skills ?? []).includes('woodcraft')>>
	<<if typeof _npc.skills === 'undefined'>>
		<<set _npc.skills = []>>
	<</if>>
	<<run _npc.skills.push('woodcraft')>>
	<<run setup.sleepMessages.addJob('<span class="skill">' + _npc.name + ' learned the woodcraft skill</span>', 'forest')>>
<</if>>
<<set _chanceOfNotComingHome = 6>>
<<if _npc.strength >= 60>>
	<<set _chanceOfNotComingHome -= 4>>
<<elseif _npc.strength >= 30>>
	<<set _chanceOfNotComingHome -= 2>>
<</if>>
<<if (_npc.skills ?? []).includes('woodcraft')>>
	<<set _chanceOfNotComingHome -= 1>>
<</if>>
<<if setup.npcInventoryHas(_npc, 'knife')>>
	<<set _chanceOfNotComingHome -= 1>>
<</if>>
<<if setup.npcInventoryHas(_npc, 'crossbow') || setup.npcInventoryHas(_npc, 'bow')>>
	<<set _chanceOfNotComingHome -= 1>>
<</if>>
<<set _chanceOfNotComingHome = Math.max(1, _chanceOfNotComingHome)>>

/* Animal attack chance — higher if no knife, lower if strong */
<<set _chanceAnimalAttack = 8>>
<<if setup.npcInventoryHas(_npc, 'knife')>>
	<<set _chanceAnimalAttack -= 4>>
<</if>>
<<if _npc.strength >= 30>>
	<<set _chanceAnimalAttack -= 3>>
<</if>>

/* Falling tree injury chance — lower if woodcraft skilled */
<<set _chanceTreeInjury = 4>>
<<if (_npc.skills ?? []).includes('woodcraft')>>
	<<set _chanceTreeInjury = 1>>
<</if>>

<<set _isArmed = setup.npcInventoryHas(_npc, 'knife') || setup.npcInventoryHas(_npc, 'crossbow') || setup.npcInventoryHas(_npc, 'bow') || setup.npcInventoryHas(_npc, 'revolver') || setup.npcInventoryHas(_npc, 'shotgun') || setup.npcInventoryHas(_npc, 'sword')>>
<<set _isFemale = [0, 2].includes(_npc.gender)>>

<<if setup.percentageChance(_chanceOfNotComingHome) && $scavengingDidntReturn === null && !$pregnancyHappening && setup.percentageChance(30) && _isGuest>>
	<<set $scavengingDidntReturn = _guestI>>
<<elseif typeof _npc.sick === 'undefined' && setup.percentageChance(_chanceAnimalAttack)>>
	/* Worker returns but is injured from animal attack */
	<<set _npc.sick = {
		days: randomInteger(5, 12),
		desc: 'Animal wounds',
		id: 'animal_wounds'
	}>>
	<<run setup.sleepMessages.addJob('<span class="warning">' + _npc.name + ' was attacked by a wild animal in the forest and returned wounded. They will need ' + _npc.sick.days + ' days to recover.</span>', 'forest')>>
<<elseif typeof _npc.sick === 'undefined' && setup.percentageChance(_chanceTreeInjury)>>
	/* Worker returns but hurt from a falling tree */
	<<set _npc.sick = {
		days: randomInteger(7, 20),
		desc: 'Crushed by falling tree',
		id: 'broken_bones'
	}>>
	<<run setup.sleepMessages.addJob('<span class="warning">' + _npc.name + ' was struck by a falling tree in the forest. They made it back but are badly hurt and need ' + _npc.sick.days + ' days rest.</span>', 'forest')>>
<<elseif _isFemale && !_isArmed && typeof _npc.sick === 'undefined' && $forestKidnapEvent === null && (!$game.forest_kidnap_day || ($game.forest_kidnap_day + 5) <= $game.day) && setup.percentageChance(3) && _isGuest>>
	/* Kidnapper — unarmed female worker taken by strangers */
	<<set $forestKidnapEvent = _guestI>>
	<<set $game.forest_kidnap_day = $game.day>>
	<<run setup.sleepMessages.addJob('<span class="warning">' + _npc.name + ' didn\'t come back from the forest. Another worker says they saw two strangers drag her off the path.</span>', 'forest')>>
<<elseif _isFemale && !_isArmed && typeof _npc.sick === 'undefined' && setup.percentageChance(5)>>
	/* Assault — unarmed female worker attacked, returns shaken */
	<<set _npc.happy = Math.max((_npc.happy ?? 0) - 20, -100)>>
	<<set _npc.relationship = Math.max((_npc.relationship ?? 0) - 15, -100)>>
	<<run setup.sleepMessages.addJob('<span class="warning">' + _npc.name + ' came back from the forest quiet and won\'t say much. Bruising visible. She needs space.</span>', 'forest')>>
<<elseif typeof _npc.sick === 'undefined' && $forestTollEvent === null && (!$game.forest_toll_day || ($game.forest_toll_day + 7) <= $game.day) && setup.percentageChance(4) && _isGuest>>
	/* Protection demand — stranger wants caps to let workers pass */
	<<set $forestTollEvent = {npcIndex: _guestI, amount: randomInteger(20, 50)}>>
	<<set $game.forest_toll_day = $game.day>>
	<<run setup.sleepMessages.addJob('<span class="warning">' + _npc.name + ' came back with a message from an armed stranger — pay ' + $forestTollEvent.amount + ' caps or expect trouble for your workers.</span>', 'forest')>>
<<else>>
	<<set _giveWood = (_npc.strength > 30 ? 2 : 1)>>
	<<if (_npc.skills ?? []).includes('woodcraft')>>
		<<set _giveWood++>>
	<</if>>
	<<if setup.npcInventoryHas(_npc, 'axe')>>
		<<set _giveWood = _giveWood * 2>>
	<</if>>
	<<set _giveWood = setup.personality.output(_npc, _giveWood)>>
	<<set _totals.wood += _giveWood>>
	<<if _isStorageAvailable>>
		<<pickup $storage 'wood' _giveWood>>
	<<else>>
		<<pickup $backpack 'wood' _giveWood>>
	<</if>>
	<<run setup.sleepMessages.addJob(_npc.name + ' managed to collect <strong>' + _giveWood + '</strong> wood in the forest', 'forest')>>
	<<if setup.percentageChance(15) && (_npc.strength ?? 0) < 100>>
		<<set _npc.strength = Math.min((_npc.strength ?? 0) + 1, 100)>>
		<<run setup.sleepMessages.addJob(_npc.name + ' is building muscle from the hard work. <strong>+1 strength</strong>', 'forest')>>
	<</if>>
	<<if setup.percentageChance(10)>>
		<<set _totals.food++>>
		<<if _isStorageAvailable>>
			<<pickup $storage 'food' 1>>
		<<else>>
			<<pickup $backpack 'food' 1>>
		<</if>>
		<<run setup.sleepMessages.addJob(_npc.name + ' managed to find some berries while working in the forest. <strong class="iitem">+1 food</strong>', 'forest')>>
	<</if>>
<</if>>
