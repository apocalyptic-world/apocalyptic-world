:: Widget newtransgirl [widget]
<<widget newtransgirl>>
	/* A random adult (setup.humans.newAdult). _npc, _gender and _names are still set because some passages read them. */
	<<set _gender = 2, _names = setup.npcFemaleNames>>
	<<set _npc = setup.humans.newAdult({ gender: 2, now: $gameDate })>>
	<<set $tmpGirl = _npc>>
<</widget>>
