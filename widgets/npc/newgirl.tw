:: Widget newgirl [widget]
<<widget newgirl>>
	/* A random adult (setup.humans.newAdult). _npc, _gender and _names are still set because some passages read them. */
	<<set _gender = 0, _names = setup.npcFemaleNames>>
	<<set _npc = setup.humans.newAdult({ gender: 0, now: $gameDate })>>
	<<set $tmpGirl = _npc>>
<</widget>>
