:: Widget - sleep [widget]
<<widget sleep>>
	<<set _t0 = performance.now()>>
	<<run setup.sleepMessages.init()>>
	<<include 'Bedrom - auto_morning'>>
	<<if _outputAutoList>>
		<<run setup.sleepMessages.messages.rules = [_outputAutoList]>>
	<</if>>
	<<unset $slaveId, $charId, $guestId, $game.partyNight>>
	<<set $game.sickPeople = []>>
	<<run delete $tmpGirlViewBack>>
	<<run delete $tmpGirlBack>>
	<<unset $pregnancyHappening, $pregnancyStreetsHappening, $scavengingDidntReturn>>
	<<set $pregnancysHappeningHospital = []>>
	<<set _energyPenalty = 0>>
	<<if $gameDate.getHours() < 8>>
		<<set _addDay = 0>>
		<<set _energyPenalty = 8 - $gameDate.getHours()>>
	<<else>>
		<<set _addDay = 1>>
	<</if>>
	<<set _totals = {caps: 0, food: 0, hay: 0, wood: 0}>>
	
	<<run 
		$gameDate.setDate($gameDate.getDate() + _addDay);
		$gameDate.setHours(8);
		$gameDate.setMinutes(0);
	>>
	
	<<if typeof $storage === 'undefined'>>
  		<<newinv $storage>>
	<</if>>
	<<set _isStorageAvailable = ($game.location.shop ?? false)>>

  <<set $player.energy = $player.maxEnergy>>
  <<run delete $player?.quests.hottub>>
  <<set _totals.food -= setup.cabinInventory.has('food') ? 1 : 0>>
  <<unset $tmpEventWedding>>
  <<if $storage.has('food')>>
  		<<drop $storage 'food' 1>>
		<<set $player.hunger = 100>>
  <<elseif $backpack.has('food')>>
  		<<drop $backpack 'food' 1>>
		<<set $player.hunger = 100>>
  <<else>>
  	  <<set $player.hunger -= 30>>
	  <<run setup.sleepMessages.addMain('<span class="starving">You are starving!</span>')>>
  <</if>>
  <<set $player.mast to false>>
  <<set $player.showered to false>>
  <<set $player.drinkMilk = false>>
  <<set $player.fight_today to false>>
  <<set $player.drunk = 0>>
  <<set $player.nap = false>>
  <<set $player.metTransGirl = false>>
  <<horny 5>>
  <<set $game.day += 1>>
  <<if ($game.streetsKilledNpc?._killedDay ?? 0) + 3 < $game.day>><<unset $game.streetsKilledNpc>><</if>>
  <<set _settleDaily = setup.settlements.dailyUpdateAll()>>
  <<for _sdi = 0; _sdi < (_settleDaily.destroyed ?? []).length; _sdi++>>
    <<run setup.sleepMessages.addMain(_settleDaily.destroyed[_sdi] + ' has gone quiet. Word is, they didn\'t make it.')>>
  <</for>>
  <<for _shi = 0; _shi < (_settleDaily.needsHelp ?? []).length; _shi++>>
    <<run setup.sleepMessages.addMain(_settleDaily.needsHelp[_shi].name + ' is under attack. They\'ve sent word asking for help.')>>
  <</for>>
  <<for _uai = 0; _uai < (_settleDaily.newUltimatums ?? []).length; _uai++>>
    <<run setup.sleepMessages.addMain('A messenger from ' + _settleDaily.newUltimatums[_uai].name + ' delivered a warning: pay ' + _settleDaily.newUltimatums[_uai].amount + ' caps within 3 days, or face the consequences.')>>
  <</for>>
  <<if (_settleDaily.expiredUltimatums ?? []).length && !($game.pendingUltimatumRaid ?? false)>>
    <<set $game.pendingUltimatumRaid = _settleDaily.expiredUltimatums[0].id>>
    <<run setup.sleepMessages.addMain(_settleDaily.expiredUltimatums[0].name + ' has run out of patience. They\'re moving on your base.')>>
  <</if>>
  <<if (_settleDaily.refugees ?? []).length && !($game.refugeeEvent ?? false)>>
    <<set $game.refugeeEvent = _settleDaily.refugees[0]>>
    <<run setup.sleepMessages.addMain('Survivors from ' + _settleDaily.refugees[0].name + ' — ' + _settleDaily.refugees[0].count + ' ' + (_settleDaily.refugees[0].count === 1 ? 'person' : 'people') + ' — have arrived at your gate asking for shelter.')>>
  <</if>>
  <<for _fai = 0; _fai < (_settleDaily.starving ?? []).length; _fai++>>
    <<run setup.sleepMessages.addMain('Word reached you from ' + _settleDaily.starving[_fai].name + ': their food supply is nearly gone. People are going hungry.')>>
  <</for>>
  <<if (_settleDaily.womanDemands ?? []).length && !($game.womanDemand ?? false)>>
    <<set $game.womanDemand = _settleDaily.womanDemands[0]>>
    <<run setup.sleepMessages.addMain('A message arrived from ' + _settleDaily.womanDemands[0].name + ': "Send us a woman within 3 days. Don\'t make us come and take one."')>>
  <</if>>
  <<for _ewdi = 0; _ewdi < (_settleDaily.expiredWomanDemands ?? []).length; _ewdi++>>
    <<run setup.sleepMessages.addMain(_settleDaily.expiredWomanDemands[_ewdi].name + '\'s patience has run out. They\'re coming.')>>
    <<if !($game.pendingUltimatumRaid ?? false)>>
      <<set $game.pendingUltimatumRaid = _settleDaily.expiredWomanDemands[_ewdi].id>>
    <</if>>
  <</for>>
  <<if (_settleDaily.newBlackmails ?? []).length && !($game.blackmailEvent ?? false)>>
    <<set $game.blackmailEvent = _settleDaily.newBlackmails[0]>>
    <<run setup.sleepMessages.addMain(_settleDaily.newBlackmails[0].name + ' knows things about your operation. They want 300 caps for their silence — or something else. You have 4 days.')>>
  <</if>>
  <<for _ebi = 0; _ebi < (_settleDaily.expiredBlackmails ?? []).length; _ebi++>>
    <<run setup.sleepMessages.addMain(_settleDaily.expiredBlackmails[_ebi].name + ' sold what they knew. Hostile groups in the area are better informed about your base now.')>>
    <<if $game.blackmailEvent && $game.blackmailEvent.id === _settleDaily.expiredBlackmails[_ebi].id>>
      <<unset $game.blackmailEvent>>
    <</if>>
  <</for>>
  <<if (_settleDaily.abductionCandidates ?? []).length && !($game.targetedAbduction ?? false)>>
    <<set _abCand = _settleDaily.abductionCandidates[0]>>
    <<set _femGuests = $guests.filter(function(g) { return g.gender === 0 && setup.getAge(g) >= 18; })>>
    <<if _femGuests.length>>
      <<set _abTarget = _femGuests[randomInteger(0, _femGuests.length - 1)]>>
      <<set $game.targetedAbduction = { settlementId: _abCand.id, settlementName: _abCand.name, guestId: _abTarget.id, guestName: _abTarget.name }>>
      <<run setup.sleepMessages.addMain(_abCand.name + ' has sent word: they\'ve taken notice of ' + _abTarget.name + '. They\'re coming to collect.')>>
    <</if>>
  <</if>>
  <<if (_settleDaily.desperateDeals ?? []).length && !($game.desperateDeal ?? false)>>
    <<set $game.desperateDeal = _settleDaily.desperateDeals[0]>>
    <<run setup.sleepMessages.addMain('A messenger from ' + _settleDaily.desperateDeals[0].name + ' came to the gate. They\'re starving and have a proposition — they\'re willing to offer one of their own in exchange for aid.')>>
  <</if>>
  <<if (_settleDaily.tributeOffers ?? []).length && !($game.tributeGift ?? false)>>
    <<set $game.tributeGift = _settleDaily.tributeOffers[0]>>
    <<run setup.sleepMessages.addMain('A small delegation from ' + _settleDaily.tributeOffers[0].name + ' arrived at dawn with a woman in tow. A tribute, they said. A sign of respect.')>>
  <</if>>
  <<set _alliedFarms = setup.settlements.getAllied().filter(function(s) { return s.type === 'farming_community'; })>>
  <<if _alliedFarms.length && $game.day % 7 === 0>>
    <<run setup.cabinInventory.pickup('food', _alliedFarms.length * 2)>>
    <<run setup.sleepMessages.addMain('A courier from ' + _alliedFarms[0].name + ' left food supplies at the gate.')>>
  <</if>>
  <<set _alliedMedics = setup.settlements.getAllied().filter(function(s) { return s.type === 'medical_colony'; })>>
  <<if _alliedMedics.length && $game.day % 14 === 0>>
    <<run setup.cabinInventory.pickup('bandage', _alliedMedics.length * 2)>>
    <<run setup.sleepMessages.addMain('A supply package from ' + _alliedMedics[0].name + ' arrived — bandages and medical supplies.')>>
  <</if>>

  <<run for (const k in $locationEvents) $locationEvents[k] = false;>>
  
<<set _giveFood = (($game.location.greenhouse ?? false) ? 2 : 1)>>

<<set _isHeatWave = $weather?.heatWave ?? false>>
<<set _isSandStorm = $weather?.sandStorm ?? false>>
<<set _isColdSnap = $weather?.coldSnap ?? false>>

<<set _hasWorkingHospital = setup.hasWorkingHospital()>>
<<set _milkwarden = setup.getPersonsForLocation($guests, 'milkwarden')>>
<<set _hasMilkwarden = _milkwarden.length>>
<<set _doctorCount = setup.getDoctors()>>
<<set _miscarrieageChanceBase = 12>>
<<set _miscarrieageChance = _miscarrieageChanceBase - (_doctorCount * 2)>>
<<set _isLowFood = setup.cabinInventory.count('food') < ($slaves.length + $guests.length)>>

<<set _hasElectricity = setup.baseManagement.electricity.hasElectricity()>>
// Horse
<<if ($player.horse ?? false)>>
	<<if typeof $characters.horse === 'undefined'>>
		<<set $characters.horse = {
			name: $player.horse,
			food: 100
		}>>
	<</if>>
	<<set $characters.horse.food -= 40>>
  	<<set _totals.hay -= setup.cabinInventory.has('hay') ? 1 : 0>>
	<<if $storage.has('hay')>>
		<<drop $storage 'hay' 1>>
		<<set $characters.horse.food = 100>>
	<<elseif $backpack.has('hay')>>
		<<drop $backpack 'hay' 1>>
		<<set $characters.horse.food = 100>>
	<<elseif $characters.horse.food >0>>
		<<run setup.sleepMessages.addMain('<span class="starving">Your horse is starving!</span>')>>
	<</if>>
	
	<<if $characters.horse.food <= 0>>
		<<run delete $player.horse>>
		<<run delete $characters.horse>>
		<<run setup.sleepMessages.addMain('<span class="dead">Your horse died of starvation!</span>')>>
		<<set _totals['horse'] = -1>>
	<</if>>
<</if>>

<<set _randomScavengingItems = clone(setup.items.scavenging)>>
<<run
	for (const [key, chance] of Object.entries(setup.items.scavenging_chance)) {
		if (setup.percentageChance(chance)) _randomScavengingItems.push(key);
	}
	_randomScavengingItems = _randomScavengingItems.filter(k =>
		typeof setup.items.scavenging_max[k] === 'undefined' ||
		setup.items.scavenging_max[k] >= setup.cabinInventory.count(k)
	);
>>

<<set _sleepNpcOpts = { type: 'slave', day: $game.day, subDecayDisabled: ($player?.quests?.subDecayDisabled ?? false), isHeatWave: _isHeatWave, isSandStorm: _isSandStorm, isColdSnap: _isColdSnap, miscarriageChance: _miscarrieageChance, hasWorkingHospital: _hasWorkingHospital, hasMilkwarden: _hasMilkwarden, hasElectricity: _hasElectricity, giveFood: _giveFood, randomScavengingItems: _randomScavengingItems, pendingRemovals: [], shouldSkip: false }>>
<<for _i to 0; _i lt $slaves.length; _i++>>
		<<set _npc = $slaves[_i]>>
		<<set _sleepNpcOpts.npcIndex = _i>>
		<<run setup.sleep.processNpc(_npc, _sleepNpcOpts)>>
		<<if _sleepNpcOpts.shouldSkip>><<continue>><</if>>

		<<set _isSick = _sleepNpcOpts.resultIsSick>>
		<<set _dayOff = _sleepNpcOpts.resultIsDayOff>>
		<<set _isGuest = false>>
		<<if _npc.assignedTo === 'nightclub' && !_dayOff && !_isSandStorm && (!_isColdSnap || setup.npcInventoryHas(_npc, 'coat_wolf'))>>
			<<include 'sleepNightClub'>>
		<</if>>
		<<if _npc.assignedTo === 'strip_club' && !_dayOff && !_isSandStorm && (!_isColdSnap || setup.npcInventoryHas(_npc, 'coat_wolf'))>>
			<<include 'sleepStripClub'>>
		<</if>>
		<<set _hunter_no_bow = ( $automatization.hunter ?? false) && _npc.assignedTo === 'hunter' && !setup.npcInventoryHas(_npc, 'bow') >>
		<<if (_hunter_no_bow || _npc.assignedTo === 'forest')  && !_isSick && !_isSandStorm && (!_isColdSnap || setup.npcInventoryHas(_npc, 'coat_wolf'))>>
			<<include 'sleepForest'>>
		<</if>>
		<<unset _hunter_no_bow>>
		<<include 'sleepNpcInventory'>>

		// Starvation
		<<if _isHeatWave>>
			<<set $slaves[_i].food = -10>>
		<</if>>
		<<if _isLowFood>>
			<<set $slaves[_i].happy -=2>>
		<</if>>
		<<if !($slaves[_i].traits ?? []).includes('hoarder')>>
			<<if $slaves[_i].food <= 10>>
				<<set _totals.food -= setup.cabinInventory.has('food') ? 1 : 0>>
				<<if $storage.has('food')>>
					<<drop $storage 'food' 1>>
					<<set $slaves[_i].food to 100>>
					<<set $slaves[_i].happy++>>
				<<elseif $backpack.has('food')>>
					<<drop $backpack 'food' 1>>
					<<set $slaves[_i].food to 100>>
					<<set $slaves[_i].happy++>>
				<</if>>

				<<if $slaves[_i].food <= -20>>
					<<set _totals['slave'] = (_totals['slave'] ?? 0) - 1>>
					<<run setup.sleepMessages.addMain('<span class="dead">' + _npc.name + ' died of hunger. You dont have enough food!</span>')>>
					<<set $slaves.splice(_i, 1)>>
					<<set _i-->>
					<<continue>>
				<<elseif $slaves[_i].food <= 10>>
					<<run setup.sleepMessages.addMain('<span class="starving">' + _npc.name + ' is starving</span>')>>
				<</if>>
			<</if>>
			<<if setup.getAge($slaves[_i]) >= 5>>
				<<set $slaves[_i].food -= 30>>
			<</if>>
		<</if>>


		// Birthday
		<<if _npc.birthDate.getDate() == $gameDate.getDate() && _npc.birthDate.getMonth() == $gameDate.getMonth()>>
			<<run setup.sleepMessages.add('Your slave <strong>' + _npc.name + '</strong> has a birthday today (turning <strong>' + setup.getAge(_npc) + '</strong>)! Favorite gift(s): <strong>' + (_npc.likes ?? 'no preference') + '</strong>', 'birthdays')>>
		<</if>>
		// Anniversary
		<<set _annivEntry = (_npc.history ?? []).find(h => h.event === 'married')>>
		<<if _annivEntry && setup.npc.isAnniversary(_npc)>>
			<<set _seenAnnivPairs = _seenAnnivPairs ?? new Set()>>
			<<set _annivYears = setup.npc.yearsMarried(_npc)>>
			<<if _annivEntry.with === 'mc'>>
				<<run setup.sleepMessages.add('Today is the <strong>' + _annivYears + '-year</strong> wedding anniversary between <strong>you</strong> and <strong>' + _npc.name + '</strong>! Favorite gift(s): <strong>' + (_npc.likes ?? 'no preference') + '</strong>', 'birthdays')>>
			<<else>>
				<<set _annivKey = [_npc.id, _annivEntry.with].sort().join('|')>>
				<<if !_seenAnnivPairs.has(_annivKey)>>
					<<run _seenAnnivPairs.add(_annivKey)>>
					<<set _spouseNpc = setup.getNpcById(_annivEntry.with)>>
					<<run setup.sleepMessages.add('Today is the <strong>' + _annivYears + '-year</strong> wedding anniversary between <strong>' + _npc.name + '</strong> and <strong>' + (_spouseNpc?.name ?? 'someone') + '</strong>! Favorite gift(s): <strong>' + (_npc.likes ?? 'no preference') + '</strong>', 'birthdays')>>
				<</if>>
			<</if>>
		<</if>>

<</for>>

// Deferred slave removals — reverse order preserves lower indices
<<for _remI = _sleepNpcOpts.pendingRemovals.length - 1; _remI >= 0; _remI-->>
	<<run $slaves.splice(_sleepNpcOpts.pendingRemovals[_remI].index, 1)>>
<</for>>
<<run $slaves.filter(n=>n)>>
<<set $scavengingDidntReturn = null>>
<<set _isOvercrowded = (($guesthouseLimit - $guests.length) < 3)>>
<<if $guests.length >= $guesthouseLimit>>
	<<run setup.sleepMessages.addMain('<span class="warning">Your guesthouse is full (' + $guests.length + '/' + $guesthouseLimit + '). No new guests can arrive.</span>')>>
<<elseif _isOvercrowded>>
	<<run setup.sleepMessages.addMain('<span class="warning">Your guesthouse is almost full (' + $guests.length + '/' + $guesthouseLimit + '). Guests are getting unhappy.</span>')>>
<</if>>
<<set _sleepGuestOpts = { type: 'guest', day: $game.day, subDecayDisabled: ($player?.quests?.subDecayDisabled ?? false), isHeatWave: _isHeatWave, isSandStorm: _isSandStorm, isColdSnap: _isColdSnap, miscarriageChance: _miscarrieageChance, hasWorkingHospital: _hasWorkingHospital, hasMilkwarden: _hasMilkwarden, hasElectricity: _hasElectricity, giveFood: _giveFood, randomScavengingItems: _randomScavengingItems, pendingRemovals: [], shouldSkip: false, scavengingDidntReturnId: null }>>
<<for _guestI to 0; _guestI lt ($guests ?? []).length; _guestI++>>
		<<set _npc = $guests[_guestI]>>
		<<if _isOvercrowded>>
			<<setNpcStats 'guest' _guestI 'happy' -5>>
		<</if>>
		<<set _sleepGuestOpts.npcIndex = _guestI>>
		<<run setup.sleep.processNpc(_npc, _sleepGuestOpts)>>
		<<if _sleepGuestOpts.shouldSkip>><<continue>><</if>>

		<<set _isSick = _sleepGuestOpts.resultIsSick>>
		<<set _dayOff = _sleepGuestOpts.resultIsDayOff>>
		<<set _isGuest = true>>
		<<if _npc.assignedTo === 'quarry' && !_dayOff && !_isSandStorm>>
			<<include 'sleepQuarry'>>
		<</if>>
		<<if _npc.assignedTo === 'garage' && !_dayOff>>
			<<include 'sleepGarage'>>
		<</if>>
		<<if _npc.assignedTo === 'nightclub' && !_dayOff && !_isSandStorm && (!_isColdSnap || setup.npcInventoryHas(_npc, 'coat_wolf'))>>
			<<include 'sleepNightClub'>>
		<</if>>
		<<if _npc.assignedTo === 'strip_club' && !_dayOff && !_isSandStorm && (!_isColdSnap || setup.npcInventoryHas(_npc, 'coat_wolf'))>>
			<<include 'sleepStripClub'>>
		<</if>>
		<<set _hunter_no_bow = ( $automatization.hunter ?? false) &&
			_npc.assignedTo === 'hunter' && !setup.npcInventoryHas(_npc, 'bow') >>
		<<if (_hunter_no_bow || _npc.assignedTo === 'forest')  && !_isSick && !_isSandStorm && (!_isColdSnap || setup.npcInventoryHas(_npc, 'coat_wolf'))>>
			<<include 'sleepForest'>>
		<</if>>
		<<unset _hunter_no_bow>>
		<<include 'sleepNpcInventory'>>

		// Starvation
		<<if _isHeatWave>>
			<<set $guests[_guestI].food = -10>>
		<</if>>
		<<if _isLowFood>>
			<<set $guests[_guestI].happy -=2>>
		<</if>>
		<<if !($guests[_guestI].traits ?? []).includes('hoarder')>>
			<<if $guests[_guestI].food <= 10>>
				<<set _totals.food -= setup.cabinInventory.has('food') ? 1 : 0>>
				<<if $storage.has('food')>>
					<<drop $storage 'food' 1>>
					<<set $guests[_guestI].food to 100>>
					<<set $guests[_guestI].happy++>>
				<<elseif $backpack.has('food')>>
					<<drop $backpack 'food' 1>>
					<<set $guests[_guestI].food to 100>>
					<<set $guests[_guestI].happy++>>
				<</if>>

				<<if $guests[_guestI].food <= -20>>
					<<run setup.sleepMessages.addMain('<span class="left">' + _npc.name + ' left because you don\'t not enough food!</span>')>>
					<<guestLeft _guestI>>
					<<set _guestI-->>
					<<continue>>
				<<elseif $guests[_guestI].food <= 10>>
					<<set $guests[_guestI].happy -= 50>>
					<<run setup.sleepMessages.addMain('<span class="starving">' + _npc.name + ' is starving!</span>')>>
				<</if>>
			<</if>>
			<<if setup.getAge($guests[_guestI]) >= 5>>
				<<set $guests[_guestI].food -= 30>>
			<</if>>
		<</if>>

		// Birthday
		<<if _npc.birthDate.getDate() == $gameDate.getDate() && _npc.birthDate.getMonth() == $gameDate.getMonth()>>
			<<run setup.sleepMessages.add('Your guest <strong>' + _npc.name + '</strong> has a birthday today (turning <strong>' + setup.getAge(_npc) + '</strong>)! Favorite gift(s): <strong>' + (_npc.likes ?? 'no preference') + '</strong>', 'birthdays')>>
		<</if>>
		// Anniversary
		<<set _annivEntry = (_npc.history ?? []).find(h => h.event === 'married')>>
		<<if _annivEntry && setup.npc.isAnniversary(_npc)>>
			<<set _seenAnnivPairs = _seenAnnivPairs ?? new Set()>>
			<<set _annivYears = setup.npc.yearsMarried(_npc)>>
			<<if _annivEntry.with === 'mc'>>
				<<run setup.sleepMessages.add('Today is the <strong>' + _annivYears + '-year</strong> wedding anniversary between <strong>you</strong> and <strong>' + _npc.name + '</strong>! Favorite gift(s): <strong>' + (_npc.likes ?? 'no preference') + '</strong>', 'birthdays')>>
			<<else>>
				<<set _annivKey = [_npc.id, _annivEntry.with].sort().join('|')>>
				<<if !_seenAnnivPairs.has(_annivKey)>>
					<<run _seenAnnivPairs.add(_annivKey)>>
					<<set _spouseNpc = setup.getNpcById(_annivEntry.with)>>
					<<run setup.sleepMessages.add('Today is the <strong>' + _annivYears + '-year</strong> wedding anniversary between <strong>' + _npc.name + '</strong> and <strong>' + (_spouseNpc?.name ?? 'someone') + '</strong>! Favorite gift(s): <strong>' + (_npc.likes ?? 'no preference') + '</strong>', 'birthdays')>>
				<</if>>
			<</if>>
		<</if>>

<</for>>

// Deferred guest removals — reverse order preserves lower indices
<<for _remI = _sleepGuestOpts.pendingRemovals.length - 1; _remI >= 0; _remI-->>
	<<guestLeft _sleepGuestOpts.pendingRemovals[_remI].index>>
<</for>>
// Resolve scavenging-didn't-return to a post-removal index via guest id
<<if _sleepGuestOpts.scavengingDidntReturnId>>
	<<set $scavengingDidntReturn = $guests.findIndex(function(g) { return g.id === _sleepGuestOpts.scavengingDidntReturnId; })>>
<</if>>

<<for _nurseryI to 0; _nurseryI lt ($nursery ?? []).length; _nurseryI++>>
		<<set _npc = $nursery[_nurseryI]>>
		<<set _npc.sleeping = false>>
		// Starvation
		<<if $nursery[_nurseryI].food <= 10>>
  			<<set _totals.food -= setup.cabinInventory.has('food') ? 1 : 0>>
			<<if $storage.has('food')>>
				<<drop $storage 'food' 1>> 
				<<set $nursery[_nurseryI].food to 100>>
			<<elseif $backpack.has('food')>>
				<<drop $backpack 'food' 1>> 
				<<set $nursery[_nurseryI].food to 100>>
			<<else>>
				<<run setup.sleepMessages.add('<span class="dead">Kid ' + $nursery[_nurseryI].name + ' died because you don\'t have enough food!</span>', 'nursery')>>
				<<set $nursery.splice(_nurseryI, 1)>>
				<<set _nurseryI-->>
				<<continue>>
			<</if>>
		<</if>>
		<<if setup.getAge($nursery[_nurseryI]) >= 5>>
			<<set $nursery[_nurseryI].food -= 30>>
		<</if>>
		
		<<if setup.getAge($nursery[_nurseryI]) >= 18>>
			<<run setup.npc.addHistory($nursery[_nurseryI], 'grown_up')>>
			<<run setup.sleepMessages.add('Kid ' + $nursery[_nurseryI].name + ' has grown up and moved to the guest house.', 'nursery')>>
			<<if (setup.percentageChance(75))>>
				<<set _orientation = 'straight'>>
			<<else>>	
				<<set _orientation = 'bisexual'>>
			<</if>>
			<<run $nursery[_nurseryI] = setup.setSexuality($nursery[_nurseryI], _orientation)>>
			<<run $guests.push($nursery[_nurseryI])>>
			<<set $nursery.splice(_nurseryI, 1)>>
			<<set _nurseryI-->>
		<</if>>

		// Birthday
		<<if _npc.birthDate.getDate() == $gameDate.getDate() && _npc.birthDate.getMonth() == $gameDate.getMonth()>>
			<<set _genderClass = 'gender-' + setup.genderClass(_npc)>>
			<<if (_npc.family ?? false) && (_npc.family.mother ?? false)>>
				<<set _motherNpc = setup.getNpcById(_npc.family.mother)>>
			<</if>>
			<<run setup.sleepMessages.add('Kid <strong><span class="'+_genderClass+'">' + _npc.name + '</span></strong>, child of  ' + (_motherNpc ? _motherNpc.name : "????") + ', has a birthday today (turning <strong>' + setup.getAge(_npc) + '</strong>)! ', 'birthdays')>>
		<</if>>
<</for>>

<<for _charI, _char range $characters>>
	<<if typeof $characters[_charI].quests !== 'undefined'>>
		<<set $characters[_charI].talked = false>>
		<<set $characters[_charI].milked to false>>
		<<set $characters[_charI].groped to false>>
		<<set $characters[_charI].washed = false>>
		<<set $characters[_charI].workout to false>>
		<<set $characters[_charI].gift = false>>
		<<set $characters[_charI].cosmetics = false>>
		<<if $characters[_charI].horny <= 90>>
			<<set $characters[_charI].horny += window.randomInteger(1, 9)>>
		<<else>>
			<<set $characters[_charI].horny = 0>>
		<</if>>

		// Pregnancy
		<<if typeof $characters[_charI].pregnancy !== 'undefined'>>
			<<set $characters[_charI].pregnancy++>>
			<<if ($characters[_charI].traits ?? []).includes('breeder')>>
				<<set $characters[_charI].pregnancy++>>
			<</if>>
			<<if $characters[_charI].pregnancy == 8>>
				<<run setup.sleepMessages.addMain($characters[_charI].name + ' told you that <strong>she is pregnant</strong>.')>>
				<<set $characters.vincent.quests.pregnancy = true>>
				<<if _charI === 'blair'>>
					<<set $characters.blair.quests.pregnancy = true>>
				<</if>>
			<</if>>
			
			<<if !$pregnancyHappening && $characters[_charI].pregnancy > 260 && ($characters[_charI].pregnancy > 280 || randomInteger(1,3) === 3)>>
				<<if _hasWorkingHospital>>
					<<run $pregnancysHappeningHospital.push(
						{
							type: 'character',
							id: _charI
						}
					)>>
				<<else>>
					<<set $pregnancyHappening = {
						type: 'character',
						id: _charI
					}>>
				<</if>>
			<</if>>
		<</if>>
	<</if>>
<</for>>

<<if isMetChar('laura')>>
	<<set $characters.laura.quests.sampleToday = false>>
	<<if $characters.laura.quests.productionSamples >= 3 && $characters.laura.quests.living && $characters.laura.quests.productionLastDay < ($game.day - $characters.laura.quests.productionDaysPerPotion)>>
		<<set $characters.laura.quests.productionSamples -= 3>>
		<<set _totals['growth_potion'] = (_totals['growth_potion'] ?? 0) + 1>>
		<<pickup $backpack 'growth_potion' 1>>
		<<set $characters.laura.quests.productionLastDay = $game.day>>
		<<run setup.sleepMessages.addMain('Laura crafted a new <strong class="iitem">growth potion</strong>')>>
	<</if>>
<</if>>


<<set _sleepDead = null>>

<<include 'sleepPerks'>>
<<include 'sleepRottenFood'>>
<<include 'sleepShowTotals'>>
<<include 'sleepManageGoods'>>
<<include 'sleepRelationship'>>
<<include 'sleepSettlers'>>
<<include 'sleepSettlementEvents'>>

<<unset $tmpGirlCapture>>

// moon
<<if setup.isNewMoon()>>
	<<if $characters.vincent.quests.pregnancy_talked>>
		<<run setup.sleepMessages.add('This time of the month, around the new moon, the glowing mushrooms seem to be more abundant. Visit the forest!', 'weather')>>
	<<else>>
		<<run setup.sleepMessages.add('This time of the month, around the new moon, strange things occur in the forest...', 'weather')>>
	<</if>>
<<elseif setup.isFullMoon()>>
	<<run setup.sleepMessages.add('This time of the month, around the full moon, you may have luck with the wolves. Visit the forest!', 'weather')>>
<</if>>

<<include 'sleepCoalFurnace'>>

// electricity
<<if setup.baseManagement.electricity.storageMax()>>
	<<set $player.baseManagement.electricityStorage = Math.max(
		0,
		Math.min(
			setup.baseManagement.electricity.storageMax(),
			($player.baseManagement.electricityStorage ?? 0) + setup.baseManagement.electricity.total()
		)
	)>>
<</if>>

// restore coal furnace building flag after electricity was calculated without it
<<if _coalFurnaceOffline>>
	<<set $player.baseManagement.buildings.coal_furnace = 1>>
<</if>>

// Milk warden
<<if _hasMilkwarden && setup.cabinInventory.count('milk') >= 3>>
	<<set _milkwarden = setup.getPersonsForLocation($guests, 'milkwarden')>>
	<<if _milkwarden.length && $guests[_milkwarden[0]]>>
		<<run setup.sleepMessages.addJob($guests[_milkwarden[0]].name + ' produced 2 cheese\'s (food) from milk', 'milk_barn')>>
		<<run setup.cabinInventory.pickup('food', 2)>>
		<<run setup.cabinInventory.drop('milk', 3)>>
	<</if>>
<</if>>
<<if $player.hunger <= 0 && !_sleepDead>>
	<<set _sleepDead = 'hunger'>>
<</if>>
<<if !_sleepDead>>
<<set $player.showered to false>>

<<if $player.horny > 70>>
	<<set $player.energy -= 30>>
<</if>>
<<updatemeter '$energyBar' `$player.energy / $player.maxEnergy`>>
<<updatemeter '$hungerBar' `$player.hunger / $player.maxHunger`>>
<<if $args[0]>>
	<<goto $args[0]>>
<<else>>

	<<if $sleepOver && setup.percentageChance(100)>>
		<<goto 'Bedroom - invite to sleep in bedroom morning'>>
	<<else>>
		<<goto "Bedroom-sleep">>
	<</if>>
<</if>>
<<else>>
	<<set $game.death_reason = _sleepDead>>
	<<goto "Dead">>
<</if>>


<<shopMerchantUpdate>>
<<if _hasWorkingHospital>>
	<<sleepHospital>>
<</if>>
<<if $game.location.school>>
	<<sleepSchool>>
<</if>>
<<if $args[0]>>
	<<set $morningMessages = []>>
	<<set $dailyUpdate = setup.sleepMessages.get()>>
<<else>>
	<<set $morningMessages = setup.sleepMessages.get()>>
<</if>>

<</widget>>


