:: Basement [Place bg-basement] {"position":"1202,389","size":"100,100"}
<<set _workingInGarden = 0>>
<<set _workingOnStreets = 0>>
<<set _showSlavesCount = 0>>

<h1 class="ptitle">
	<<backButton 'Wood cabin'>>
	BASEMENT
</h1>
<<set _voluntaryGuests = ($guests ?? []).map(function(g, i) { return { npc: g, idx: i }; }).filter(function(e) { return e.npc.basementVoluntary; })>>
<<if _voluntaryGuests.length > 0>>
<h3>Guests</h3>
<table id="guests" class="npc-list">
<<for _vgEntry range _voluntaryGuests>>
<<capture _vgEntry>>
<<set _vgGenderClass = 'gender-' + setup.genderClass(_vgEntry.npc)>>
<<set _vgColorStyle = (typeof _vgEntry.npc.color !== 'undefined') ? (' npc-color color-' + _vgEntry.npc.color) : ''>>
<tr class="item">
	<td style="min-width: 25%">
		<span @class="_vgGenderClass + _vgColorStyle">
			<div class="tooltip">
				<span class="tooltiptext" style="left: -130px; background-color: transparent; opacity: 1;">
					<<set _girlVisual to _vgEntry.npc>>
					<<for _skill range (_vgEntry.npc.skills ?? [])>>
						<<if typeof setup.skills[_skill] !== 'undefined'>>
							<div class="trait tooltip">
								<<=setup.skills[_skill].title>>
							</div>
						<</if>>
						<br />
					<</for>>
					<div class="say npcsay npc-say-visual">
						<div class="girl_info_picture">
							<<if _vgEntry.npc.portrait>>
								<div class="say_custom_portrait">
									<<include 'NPC visual'>>
								</div>
							<<else>>
								<<include 'NPC visual'>>
							<</if>>
						</div>
					</div>
					<<for _trait range (_vgEntry.npc.traits ?? [])>>
						<div class="trait tooltip">
							<<=setup.traits[_trait].title>>
						</div>
						<br />
					<</for>>
				</span>
				<<link _vgEntry.npc.name>>
					<<set $tmpGirl = _vgEntry.npc>>
					<<set $tmpGirl.location = 'basement'>>
					<<set $tmpGirlBack = 'Basement'>>
					<<set $tmpGirl.rape = false>>
					<<set $tmpGirlCapture = false>>
					<<set $tmpGirlInvite = false>>
					<<set $tmpGirlViewBack = 'NPC view - guest'>>
					<<set $guestId = _vgEntry.idx>>
					<<unset $slaveId, $charId, $childId>>
					<<goto 'NPC view - guest'>>
				<</link>>
			</div>
		</span>
		<<=setup.npcListInfo(_vgEntry.npc)>>
	</td>
	<td>
		<<npcListView _vgEntry.npc _vgEntry.idx 'guest'>>
	</td>
</tr>
<</capture>>
<</for>>
</table>
<br />
<</if>>

<h3>Slaves</h3>
<<set _basementLimitShow = ($basementLimit - $slaves.length)>>
<<if _basementLimitShow < 0>>
	<<set _basementLimitShow = 0>>
<</if>>
Free rooms left: <strong><<=_basementLimitShow>></strong>

<<set _isSlaveInBasement = false>>
<<set _suicidalSlaves = []>>
<<set _lowSubmissionSlaves = []>>
<<set _slavesInBasement = []>>
<<set _isHeatWave = $weather?.heatWave ?? false>>
<<set _isSandStorm = $weather?.sandStorm ?? false>>
<<set _isColdSnap = $weather?.coldSnap ?? false>>

<<for _i to 0; _i lt $slaves.length; _i++>>
	<<set _isSick = (typeof $slaves[_i].sick !== 'undefined')>>
	<<set _isRest = (typeof $slaves[_i].rest !== 'undefined')>>
	<<set _dayOff = _isSick || _isRest>>

	<<if setup.isAtWork($slaves[_i], $weather)>>
		<<if $slaves[_i].assignedTo === 'garden'>><<set _workingInGarden++>><</if>>
		<<if $slaves[_i].assignedTo === 'streets'>><<set _workingOnStreets++>><</if>>
		<<continue>>
	<</if>>
	<<set _showSlavesCount++>>
	<<set _isSlaveInBasement = true>>
<</for>>
<<set _hornySlaveId = null>>
<<if $slaves.length < 1>>
	<div style="margin-top: 20px;">
		You have no slaves...
	</div>
<<else>>
	/* Detect mistress on duty */
	<<set _girlGuest = setup.getPersonsForLocation($guests, 'mistress')>>
	<<set _hasMistress = _girlGuest.length > 0 && setup.isAtWork($guests[_girlGuest[0]], $weather) && _isSlaveInBasement>>
	<<if _hasMistress>>
		<<set $tmpGirl = $guests[_girlGuest[0]]>>
		<<set $tmpGirl.location = 'mistress'>>
	<</if>>

	/* Collect attendants who are on duty (work hours 10:00-20:00, not sick) */
	<<set _attendantIds = []>>
	<<for _attI range setup.getPersonsForLocation($guests, 'attendant')>>
		<<if setup.isAtWork($guests[_attI], $weather) && _isSlaveInBasement>>
			<<run _attendantIds.push({type: 'guest', id: _attI})>>
		<</if>>
	<</for>>
	<<for _attI range setup.getPersonsForLocation($slaves, 'attendant')>>
		<<if setup.isAtWork($slaves[_attI], $weather) && _isSlaveInBasement>>
			<<run _attendantIds.push({type: 'slave', id: _attI})>>
		<</if>>
	<</for>>

	/* Image area — toggle if both mistress and attendant are present */
	<<if _hasMistress || _attendantIds.length > 0>>
		<<if _hasMistress && _attendantIds.length > 0>>
			<<set $player.baseManagement.basementView ??= 'mistress'>>
			<div id="basement-view-toggle" style="text-align:center; margin-bottom:6px">
				View:&nbsp;
				<label><<radiobutton "$player.baseManagement.basementView" "mistress" autocheck>>&nbsp;Mistress</label>
				&nbsp;
				<label><<radiobutton "$player.baseManagement.basementView" "attendant" autocheck>>&nbsp;Attendant</label>
			</div>
			<<done>><<run jQuery('#basement-view-toggle input[type="radio"]').on('change', function() { Engine.play('Basement'); })>><</done>>
			<<if $player.baseManagement.basementView === 'attendant'>>
				<<set _attImgNpc = _attendantIds[0].type === 'guest' ? $guests[_attendantIds[0].id] : $slaves[_attendantIds[0].id]>>
				<<set _attImgNpc.location = 'basement'>>
				<center><<actionImage _attImgNpc 'attendant' 'no-text'>></center>
			<<else>>
				<center><<actionImage $tmpGirl basement>></center>
			<</if>>
		<<elseif _hasMistress>>
			<center><<actionImage $tmpGirl basement>></center>
		<<else>>
			<<set _attImgNpc = _attendantIds[0].type === 'guest' ? $guests[_attendantIds[0].id] : $slaves[_attendantIds[0].id]>>
			<<set _attImgNpc.location = 'basement'>>
			<center><<actionImage _attImgNpc 'attendant' 'no-text'>></center>
		<</if>>
	<</if>>

	/* Mistress description + approach link */
	<<if _hasMistress>>
		<<set _activeBehaviors = []>>
		<<if ($player.baseManagement.mistressPunish ?? true)>><<set _activeBehaviors.push('punish')>><</if>>
		<<if ($player.baseManagement.mistressDiscipline ?? false)>><<set _activeBehaviors.push('discipline')>><</if>>
		<<if ($player.baseManagement.mistressCondition ?? true)>><<set _activeBehaviors.push('condition')>><</if>>
		<<set _mistressBehavior = _activeBehaviors.length > 0 ? setup.getRandomElement(_activeBehaviors) : 'idle'>>
		<<set _mistressDescriptions = {
			punish: [
				'is whipping one of your slaves at the post, making an example.',
				'is circling a kneeling slave with a riding crop.',
				'has one of your slaves bound tightly in an uncomfortable position.',
				'is trying out a new piece of equipment on one of your slaves.',
				'has one of your slaves on the ground under her foot.'
			],
			discipline: [
				'is putting one of your slaves through laps around the basement.',
				'has a slave on the ground doing push-ups as she corrects their form sharply.',
				'has one of your slaves hauling heavy loads across the room.',
				'is shouting at one of your slaves for taking a break.',
				'stands over one of your slaves, counting out sit-ups.'
			],
			condition: [
				'is whispering something into a slave\'s ear that makes them blush deeply.',
				'is teaching one of your slaves a challenging sexual position.',
				'is forcing one of your slaves to do their work in the nude.',
				'has one of your slaves tied up in a very exposing position.',
				'is reminding one of your slaves that their body belongs to their master.'
			],
			idle: [
				'is sitting in the corner, arms crossed, watching the slaves with idle disdain.',
				'is leaning against the wall, picking at her nails, visibly unimpressed.',
				'has found herself a chair and is staring at nothing in particular.',
				'is pacing slowly, as if waiting for someone to give her a reason to move.',
				'looks up as you enter, expression flat — she has nothing to do and everyone knows it.'
			]
		}>>
		<<=setup.displayName($tmpGirl)>> <<=setup.getRandomElement(_mistressDescriptions[_mistressBehavior])>><br /><br />
		<<set _girlGuestLink = 'Approach ' + $tmpGirl.name>>
		<<link `_girlGuestLink`>>
			<<set $tmpGirlViewBack = 'NPC view - guest'>>
			<<set $tmpGirlBack = 'Basement'>>
			<<set $tmpGirlCapture to false>>
			<<set $tmpGirlInvite to false>>
			<<set $tmpGirl.rape to false>>
			<<set $guestId = _girlGuest[0]>>
			<<unset $slaveId, $charId, $childId>>
			<<goto 'NPC view - guest'>>
		<</link>>
		<<set _mistressId = _girlGuest[0]>>
	<</if>>

	/* Display attendants — image already rendered above; text descriptions only here */
	<<if _attendantIds.length > 0>>
		<<set _attVerbs = ['cleaning', 'grooming', 'washing', 'drying off', 'scrubbing', 'rinsing']>>
		<<if ($player.baseManagement?.attendantStimulate ?? true)>>
			<<run _attVerbs.push('tickling', 'teasing')>>
			<<if $slaves.some(s => s.gender === 0 || s.gender === 2)>>
				<<run _attVerbs.push('fingering')>>
			<</if>>
			<<if $slaves.some(s => s.gender === 1 || s.gender === 3)>>
				<<run _attVerbs.push('stroking')>>
			<</if>>
		<</if>>
		<<set _attSelectedVerbs = _attendantIds.map(() => _attVerbs.random())>>
		<<for _attI, _attEntry range _attendantIds>>
			<<set _attNpc = _attEntry.type === 'guest' ? $guests[_attEntry.id] : $slaves[_attEntry.id]>>
			<<=setup.displayName(_attNpc)>> is <<=_attSelectedVerbs[_attI]>> one of your slaves<br />
		<</for>>
		<br />
		<<for _attEntry range _attendantIds>>
			<<set _attNpc = _attEntry.type === 'guest' ? $guests[_attEntry.id] : $slaves[_attEntry.id]>>
			<<set _attLink = 'Approach ' + _attNpc.name>>
			<<capture _attEntry, _attNpc, _attLink>>
			<<link `_attLink`>>
				<<set $tmpGirl = _attNpc>>
				<<set $tmpGirl.location = _attEntry.type === 'guest' ? 'shower' : 'basement'>>
				<<set $tmpGirlBack = 'Basement'>>
				<<set $tmpGirlCapture to false>>
				<<set $tmpGirlInvite to false>>
				<<set $tmpGirl.rape to false>>
				<<if _attEntry.type === 'guest'>>
					<<set $tmpGirlViewBack = 'NPC view - guest'>>
					<<set $guestId = _attEntry.id>>
					<<unset $slaveId, $charId, $childId>>
					<<goto 'NPC view - guest'>>
				<<else>>
					<<set $tmpGirlViewBack = 'NPC view'>>
					<<set $slaveId = _attEntry.id>>
					<<unset $guestId, $charId, $childId>>
					<<goto 'NPC view'>>
				<</if>>
			<</link>>
			<</capture>>
		<</for>>
		<br /><br />
	<</if>>

	<<if (!(typeof _mistressId === 'undefined') || _attendantIds.length > 0) && $player.quests.slave_party>>
		<<if setup.cabinInventory.count('food') >= 20 && setup.cabinInventory.count('champagne') > 0 && timeBetween('15:00', '22:00') && (setup.getAvailablePersons18yo($slaves)[0] ?? []).length >= 4>>
			<<link 'Throw a party'>>
				<<goto 'Basement - slave party'>>
			<</link>>
			<<linkdesc>>
			-20 food, -1 champagne
			<</linkdesc>>
		<<else>>
			<div class="link-internal" style="background: #ccc">
				Throw a party
			</div>
			<<linkdesc>>
				20 food, 1 champagne and time between 15:00 - 22:00 and at least 4 women as slaves.
			<</linkdesc>>
		<</if>>
	<</if>>
	<<if (setup.getAvailablePersons18yo($slaves)[0] ?? []).length >= 2 && $player.energy >= 20 && timeBetween('08:00', '23:00')>>
		<<link 'Public punishment'>>
			<<set $locationEvents.basement = true>>
			<<goto 'Basement - public punishment'>>
		<</link>>
		<<linkdesc>>
			Gather all slaves and punish 2-3 in front of everyone. All slaves gain submission.
		<</linkdesc>>
	<</if>>
	<<if (setup.getAvailablePersons18yo($slaves)[0] ?? []).length >= 3>>
		<<if timeBetween('18:00','20:30') && $player.energy >= 40>>
			<<link 'Group workout with slaves'>>
				<<energy -40>>
				<<addmins 90>>
				<<goto 'Group workout - slaves'>>
			<</link>>
		<<else>>
			<div>
				<div class="link-internal" style="background: #ccc">
					Group workout with slaves
				</div>
				<<linkdesc>>
					Time between 19:00 - 20:30. Energy 40
				<</linkdesc>>
			</div>
		<</if>>
	<</if>>

	<<if ($game.location.bathhouse ?? false) && _isSlaveInBasement>>
		<<link 'Mass shower'>>
			<<set $massShowerMistressId = _mistressId>>
			<<set $massShowerAttendantCount = _attendantIds.length>>
			<<set $massShowerAttendantNames = _attendantIds.map(a => setup.displayName(a.type === 'guest' ? $guests[a.id] : $slaves[a.id]))>>
			<<goto 'Basement - mass shower'>>
		<</link>>
	<</if>>

	<<set _slaveSorter = setup.npcSortedIndices($slaves, $bsortBy, $player.companions, 'slave:')>>

	<table id="slaves" class="npc-list">

		<tr class="item">
			<td colspan="2">
				<div class="sort-options" style="display: flex; gap: 1rem; flex-wrap: wrap;">
					<span>
						<<if ($bsortBy !== 'N')>>
							Sort by: <<link 'Name'>><<set $bsortBy = 'N'>><<goto 'Basement'>><</link>>
						<<else>>
							Sort by: <strong>Name</strong>
						<</if>>
					</span>
					<span>
						<<if ($bsortBy !== 'A')>>
							<<link 'Assignment'>><<set $bsortBy = 'A'>><<goto 'Basement'>><</link>>
						<<else>>
							<strong>Assignment</strong>
						<</if>>
					</span>
					<span>
						<<if ($bsortBy !== 'P')>>
							<<link 'Pregnancy'>><<set $bsortBy = 'P'>><<goto 'Basement'>><</link>>
						<<else>>
							<strong>Pregnancy</strong>
						<</if>>
					</span>
					<span>
						<<if (!$bsortBy || $bsortBy !== 'D')>>
							<<link 'Arrival (default)'>><<set $bsortBy = 'D'>><<goto 'Basement'>><</link>>
						<<else>>
							<strong>Arrival (default)</strong>
						<</if>>
					</span>
				</div>
			</td>
		</tr>

	<<for _sortOrder, _i range _slaveSorter>>
		<<capture _i>>
		<<set _isSick = (typeof $slaves[_i].sick !== 'undefined')>>
		<<set _isRest = (typeof $slaves[_i].rest !== 'undefined')>>
		<<set _dayOff = _isSick || _isRest>>
		<<set _genderClass = 'gender-' + setup.genderClass($slaves[_i])>>
		<<set _customColorStyle = ''>>
		<<if typeof $slaves[_i].color !== 'undefined' >>
			<<set _customColorStyle = ' npc-color color-' + $slaves[_i].color >>
		<</if>>
		<<if setup.isAtWork($slaves[_i], $weather)>>
			<<continue>>
		<</if>>

		<<if $slaves[_i].horny > 70 && _hornySlaveId === null>>
			<<set _hornySlaveId = _i>>
		<</if>>
		<<set $showSlavesCount++>>
		<<if $slaves[_i].happy < -70>>
			<<run _suicidalSlaves.push(_i)>>
		<</if>>
		<<if $slaves[_i].sub < 50>>
			<<run _lowSubmissionSlaves.push(_i)>>
		<</if>>
		<<run _slavesInBasement.push(_i)>>
		<<if (timeBetween('20:00', '23:59') && setup.npcInventoryHas($slaves[_i], 'alcohol') && !($slaves[_i].pregnancy >= 7)  && $slaves[_i].drunk <= ($slaves[_i].happy >= 50 ? 55 : ($slaves[_i].happy >= 0 ? 60 : 70)) && setup.percentageChance($slaves[_i].happy >= 50 ? 5 : ($slaves[_i].happy >= 0 ? 15 : 45)))>>
			<<set $slaves[_i].drunk =  Math.min(99, $slaves[_i].drunk + randomInteger(20, 55))>>
			<<set $slaves[_i].happy =  Math.min(100, $slaves[_i].happy + ($slaves[_i].drunk <= 50 ? 1 : ($slaves[_i].drunk <= 75 ? 2 : ($slaves[_i].drunk < 95 ? 0 : -5))))>>

			<<if setup.percentageChance(50)>>
			    <<run setup.npcInventoryRemove($slaves[_i], 'alcohol')>>
			<</if>>
		<</if>>
		<tr class="item">
			<td style="min-width: 25%">
				<<if setup.getAge($slaves[_i]) < 18>>
					<span @class="_genderClass" @style="_customColorStyle">
						<<link $slaves[_i].name>>
							<<set $slaveId = _i>>
							<<unset $guestId, $charId, $childId>>
							<<set $tmpGirl = $slaves[_i]>>
							<<set $tmpGirlBack = 'Basement'>>
							<<set $tmpGirlViewBack = 'Child view'>>
							<<goto 'Child view'>>
						<</link>>
					</span>
				<<else>>
					<span @class="_genderClass + _customColorStyle">

						<div class="tooltip">
							<<set _girlVisual to $slaves[_i]>>
							<span class="tooltiptext" style= "left: -130px;  background-color: transparent; opacity: 1;"> 
								<<for _skill range ($slaves[_i].skills ?? [])>>
									<<if typeof setup.skills[_skill] !== 'undefined'>>
										<div class="trait tooltip">
											<<=setup.skills[_skill].title>>
										</div>
									<</if>>
									<br />
								<</for>>
       								<div class="say npcsay npc-say-visual" >
           									<div class="girl_info_picture">
               									<<if _girlVisual.portrait>>
                   										<div class="say_custom_portrait">
                       										<<include 'NPC visual'>>
                   										</div>
               									<<else>>
                   										<<include 'NPC visual'>>
               									<</if>>                
									</div>
								</div>
								<<for _trait range ($slaves[_i].traits ?? [])>>
									<div class="trait tooltip">
										<<=setup.traits[_trait].title>>
									</div>
									<br />
								<</for>>
							</span>

					  		<<link $slaves[_i].name>>
								<<set $tmpGirl to $slaves[_i]>>
								<<set $tmpGirl.location = 'basement'>>
								<<set $tmpGirlBack = 'Basement'>>
								<<set $tmpGirl.rape to false>>
								<<set $tmpGirlCapture to false>>
								<<set $tmpGirlInvite to false>>
								<<set $tmpGirlViewBack = 'NPC view'>>
								<<set $slaveId = _i>>
								<<run delete $guestId>>
								<<run delete $charId>>

								<<if !$slaves[_i].gender && !($slaves[_i].quests ?? {}).firstBasementVisit>>
									<<if typeof $slaves[_i].quests === 'undefined'>>
										<<set $slaves[_i].quests = {}>>
									<</if>>
									<<set $slaves[_i].quests.firstBasementVisit = true>>
									<<goto 'Basement - first girl visit'>>
								<<else>>
									<<goto `$tmpGirlViewBack`>>
								<</if>>
					  		<</link>>
						</div>
					</span>
				  <</if>>
				  <<=setup.npcListInfo($slaves[_i], _isSick, _isRest)>>
			</td>
			<td>
				<<npcListView $slaves[_i] _i 'slave'>>
			</td>
			<td>
				<<link 'Kill'>>
					/* rescue npc inventory first */
					<<dialog 'Kill'>>
						Are you sure you want to kill <<=setup.pronounceWho($slaves[_i])>>?
						<br />
						<<link 'Yes' 'Basement'>>
							<<assignedTo $slaves[_i] 'none'>>
							<<slaveRemove _i>>
							<<dialogclose>>
							<<set $player.reputation++>>
							<<set $player.goodwill-->>
							<<statsAdd 'slaves_killed'>>
							<<statsAdd 'people_killed'>>
						<</link>>
					<</dialog>>
				<</link>>
			</td>
		</tr>
		<</capture>>
	<</for>>
	</table>
<</if>>

<<if !_showSlavesCount && _workingInGarden>>
	All your slaves are at assigned jobs...
<</if>>
<br /><br />

<<set _guestsLikesGirls = setup.commonValues([setup.getAvailablePersons18yo($guests)[1] ?? [], setup.propertyMatchIndexes($guests, 'likesGirls')])>>
<<set _slavesForFuck = setup.commonValues([setup.getAvailablePersons18yo($slaves)[0] ?? [], _slavesInBasement])>>
<<set _preGuestIdx = (_guestsLikesGirls.length > 0 ? setup.getRandomElement(_guestsLikesGirls) : null)>>
<<set _guestFuckChance = (_preGuestIdx !== null && (($guests[_preGuestIdx]?.family?.wives ?? []).length > 0 || $player?.baseManagement?.noOutOfMarriageSex)) ? 3 : 5>>

<<if _showSlavesCount &&  !$locationEvents.basement>>
	<<set _randomNumber = randomInteger(1, 10)>>
	<<if _randomNumber === 0 && _lowSubmissionSlaves.length>>
		<<set $eventSlaveId = setup.getRandomElement(_lowSubmissionSlaves)>>
		<<if setup.getAge($slaves[$eventSlaveId]) >= 18 && !$slaves[$eventSlaveId].gender>>
			<<set $locationEvents.basement = true>>
			<<set $tmpEvent = {
				id: $eventSlaveId
			}>>
			<<if setup.percentageChance(50)>>
				<<goto 'Basement event - try escape'>>
			<<else>>
				<<goto 'Basement event - try escape 2'>>
			<</if>>
		<</if>>
	<<elseif _randomNumber === 1 && _hornySlaveId !== null && setup.getAge($slaves[_hornySlaveId]) > 17 && !$slaves[_hornySlaveId].gender && !$slaves[_hornySlaveId].virgin>>
		<<set $hornySlaveId = _hornySlaveId>>
		<<set $locationEvents.basement = true>>
		<<goto 'Basement event - horny slave'>>
	<<elseif _suicidalSlaves.length && setup.percentageChance(setup.suicideChance($slaves[_suicidalSlaves[0]]))>>
		<<set $slaveId = _suicidalSlaves[0]>>
		<<set $locationEvents.basement = true>>
		<<goto 'Basement - slave hangman'>>
	<<elseif !$player.quests.slave_party && $slaves.length >= 6 && $guests.length >= 6 && ((typeof _mistressId !== 'undefined' && $guests[_mistressId].relationship >= 90) || _attendantIds.some(a => (a.type === 'guest' ? $guests[a.id] : $slaves[a.id]).relationship > 60))>>
		<<if typeof _mistressId !== 'undefined'>>
			<<set $guestId = _mistressId>>
		<<else>>
			<<unset $guestId>>
		<</if>>
		<<unset $charId, $slaveId>>
		<<set $locationEvents.basement = true>>
		<<goto 'Basement - slave party introduction'>>
	<<elseif _slavesForFuck.length && _guestsLikesGirls.length && setup.percentageChance(_guestFuckChance)>>
		<<set $locationEvents.basement = true>>
		<<set $tmpEvent = {
			guestId: _preGuestIdx,
