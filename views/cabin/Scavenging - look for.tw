:: Scavenging - look for
<h1 class="ptitle">OUTSIDE</h1>
<br /><br />
<center>
  [img[setup.ImagePath+'places/outside/scavenging_walk.webp']]
</center>
<<addhours 3>>
<br /><br />
<<set _npc = $guests[$scavengingDidntReturn]>>
You took your stuff and decided to walk in the direction you thought <<=setup.pronounceWho(_npc)>> would go. You walk for a few hours till you reached crossroads and you had to decide where to go next.
<br /><br />
/* Outcomes are weighted by how well the scavenger can look after themselves (setup.fight.scavengerCapability):
   a strong, armed and armored scavenger is rarely found dead, and at 60+ can be found holding out on their own. */
<<set _capability = setup.fight.scavengerCapability(_npc)>>
<<set _crossroadOptions = ['Scavenging - look for - alive', 'Scavenging - look for - not found']>>
<<if _capability >= 30>>
	<<run _crossroadOptions.push('Scavenging - look for - alive')>>
<</if>>
<<if _capability < 70 && (!(_npc.skills ?? []).includes('scavenger') || setup.percentageChance(50))>>
	<<run _crossroadOptions.push('Scavenging - look for - dead')>>
<</if>>
<<if _capability >= 60>>
	<<run _crossroadOptions.push('Scavenging - look for - holding out', 'Scavenging - look for - holding out')>>
<</if>>

<<if [0, 2].includes(_npc.gender)>>
	<<run _crossroadOptions.push('Scavenging - look for girl fight')>>
	<<if setup.npcInventoryHas(_npc, 'knife') && _npc.strength >= 50 && setup.npcInventoryHas(_npc, 'body_armor')>>
		<<run _crossroadOptions.push('Scavenging - look for girl fight #2')>>
	<</if>>
<</if>>
<<if _npc.assignedTo === 'forest'>>
	<<run _crossroadOptions.push('Forest - look for - wolves')>>
<</if>>
<<set _crossroadOption = either(_crossroadOptions)>>
<<addhours 3>>
<<link 'Go left'>>
	<<goto `_crossroadOption`>>
<</link>>
<<link 'Go straight'>>
	<<goto `_crossroadOption`>>
<</link>>
<<link 'Go right'>>
	<<goto `_crossroadOption`>>
<</link>>


