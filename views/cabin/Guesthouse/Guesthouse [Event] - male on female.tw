			<<set $guests[$tmpEvent.femaleGuestIds[0]].happy = Math.min(100, ($guests[$tmpEvent.femaleGuestIds[0]].happy ?? 50) + 3)>>
			<<run delete $tmpEvent.husbandGuestIdxs>>
