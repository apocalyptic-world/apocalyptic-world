<<elseif $tmpEvent.isCouple && typeof $randEvent === 'undefined'>>
	<<set _wife = $guests[$tmpEvent.femaleGuestIds[0]]>>
	<<set _husband = $guests[$tmpEvent.maleGuestIds[0]]>>
	<<if !(_wife.likesGuys ?? true)>>
