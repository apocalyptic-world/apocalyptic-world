			<<set _husband.corruption = Math.min(100, (_husband.corruption ?? 0) + 2)>>
			<<set $guests[$tmpEvent.femaleGuestIds[0]].corruption = Math.min(100, ($guests[$tmpEvent.femaleGuestIds[0]].corruption ?? 0) + 1)>>
