:: Blair - date
<h1 class="ptitle">DATE</h1>
<br /><br />
<<blair>>
	So what should we do?
<</blair>>
<br /><br />
<<if timeBetween('06:00', '19:59')>>
	<<link 'Go to skyscraper'>>
		<<set $player.companionsHome = $player.companions>>
		<<set $player.companions = {}>>
		<<goto 'Blair - date [skyscraper]'>>
	<</link>>
<</if>>
<<if timeBetween('06:00', '15:59')>>
	<<if recall($suppCode)>>
		<<link 'Go scavenging together'>>
			<<set $player.companionsHome = $player.companions>>
			<<set $player.companions = {}>>
			<<goto 'Blair - date [scavenging]'>>
		<</link>>
	<<else>>
		<div class="link-internal disabled" style="background: #ccc">
			Go scavenging together
			<<notPatreonIcon>>
		</div>
	<</if>>
<</if>>
<<if recall($suppCode)>>
	<<link 'How about just talk on the couch'>>
	        <<set $player.companionsHome = $player.companions>>
		<<set $player.companions = {}>>
		<<goto 'Blair - date [massage]'>>
	<</link>>
<<else>>
	<div class="link-internal disabled" style="background: #ccc">
		How about just talk on the couch
		<<notPatreonIcon>>
	</div>
<</if>>
<<if ($game.location.school ?? false) && timeBetween('18:00', '23:59')>>
	<<if recall($suppCode)>>
		<<link 'Go to the school'>>
			<<set $player.companionsHome = $player.companions>>
			<<set $player.companions = {}>>
			<<goto 'Blair - date [school]'>>
		<</link>>
	<<else>>
		<div class="link-internal disabled" style="background: #ccc">
			Go to the school
			<<notPatreonIcon>>
		</div>
	<</if>>
<</if>>


<<link 'Leave'>>
	<<if $blairDateBack>>
		<<set _blairDateBack = $blairDateBack>>
		<<unset $blairDateBack>>
		<<goto _blairDateBack>>
	<<else>>
		<<goto 'Kitchen-room'>>
	<</if>>
<</link>>


