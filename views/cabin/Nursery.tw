:: Nursery [Place bg-nursery] {"position":"1346,773","size":"100,100"}
<<if previous() === 'Youth district'>>
	<<if setup.nurseryCare.shouldTalk()>>
		<<goto 'Event - Nursery - caretaker talk'>>
	<<elseif setup.nurseryBirthday.start()>>
		<<goto 'Nursery encounter - birthday'>>
	<<else>>
		<<set _ncEncounter = setup.nurseryEncounters.roll()>>
		<<if _ncEncounter>>
			<<goto _ncEncounter>>
		<</if>>
	<</if>>
<</if>>
<h1 class="ptitle">
	<<backButton 'Youth district'>>		
	NURSERY
</h1>

<<set _sleepingChance = 0>>
<<if timeBetween('20:00', '23:00')>>
	<<set _sleepingChance = 40>>
<<elseif timeBetween('23:00', '23:59')>>
	<<set _sleepingChance = 70>>
<<elseif timeBetween('23:59', '01:00')>>
	<<set _sleepingChance = 100>>
<<elseif timeBetween('01:00', '02:00')>>
	<<set _sleepingChance = 100>>
<</if>>

<<include 'Nursery - care panel'>>

<<if ($nursery ?? []).length < 1>>
	<div style="margin-top: 20px;">
		No one is living here...
	</div>
<<else>>

	<<set _nurserySorter = setup.nurseryCare.sortedIndices()>>

	<<set $nSortPanelOpen ??= false>>
	<<set _nSelfReload = State.history.length > 1 && State.history[State.history.length - 2].title === 'Nursery'>>
	<<if !_nSelfReload>>
		<<set $nSortPanelOpen = false>>
	<</if>>

	<table id="slaves" class="npc-list">

		<tr class="item">
			<td colspan="2">
				<details id="nursery-sort-details">
					<summary class="sort-summary"><small>Sort options</small></summary>
					<div class="sort-options" style="display: flex; gap: 1rem; flex-wrap: wrap; margin-top: 0.5rem;">
						<span>
							<<if ($nsortBy !== 'N')>>
								Sort by: <<link 'Name'>><<set $nsortBy = 'N'>><<goto 'Nursery'>><</link>>
							<<else>>
								Sort by: <strong>Name</strong>
							<</if>>
						</span>
						<span>
							<<if ($nsortBy !== 'M')>>
								<<link 'Mother'>>
									<<set $nsortBy = 'M'>>
									<<goto 'Nursery'>>
								<</link>>
							<<else>>
								<strong> Mother </strong>
							<</if>>
						</span>
						<span>
							<<if ($nsortBy !== 'A')>>
								<<link 'Age (descending)'>>
									<<set $nsortBy = 'A'>>
									<<goto 'Nursery'>>
								<</link>>
							<<else>>
								<strong> Age (descending) </strong>
							<</if>>
						</span>
						<span>
							<<if ($nsortBy == 'N' || $nsortBy == 'M' || $nsortBy == 'A')>>
								<<link 'Arrival (default)'>><<set $nsortBy = 'D'>><<goto 'Nursery'>><</link>>
							<<else>>
								<strong>Arrival (default)</strong>
							<</if>>
						</span>
					</div>
				</details>
				<<done>>
					<<run document.getElementById('nursery-sort-details').open = State.variables.nSortPanelOpen>>
					<<run jQuery('#nursery-sort-details').on('toggle', function() { State.variables.nSortPanelOpen = this.open; })>>
				<</done>>
			</td>
		</tr>

	<<set _currentMom = ''>>

	<<for _sortOrder, _realIdx range _nurserySorter>>
		<<set _nursery = $nursery[_realIdx]>>
		<<capture _realIdx, _nursery>>
			<<set _genderClass = 'gender-' + setup.genderClass(_nursery)>>
			<<if setup.percentageChance(_sleepingChance)>>
				<<set _nursery.sleeping = true>>
			<</if>>
			<<set _customColorStyle = ''>>
			<<if typeof _nursery.color !== 'undefined' >>
				<<set _customColorStyle = ' npc-color color-' + _nursery.color >>
			<</if>>

			<<set _motherNpc = ''>>
			<<if (_nursery.family ?? false) && (_nursery.family.mother ?? false)>>
				<<set _motherNpc = setup.getNpcById(_nursery.family.mother)>>
			<</if>>
			/* Mothers who live elsewhere (settlement leaders) can't be looked up, so the child keeps her name */
			<<set _motherAway = _motherNpc ? '' : (_nursery.family?.motherName ?? '')>>
			<<set _momKey = _motherAway || _motherNpc>>
			<<if $nsortBy === 'M'>>
				<<if _momKey !== _currentMom>>
					<tr class="item">
						<td colspan="3">
							<<if (_motherNpc?.name ?? false)>>
								Kid(s) of <<=setup.displayName(_motherNpc)>>:
							<<elseif _motherAway>>
								Kid(s) of <<= _motherAway>>:
							<<else>>
								Orphan(s):
							<</if>>
						</td>
					</tr>
					<<set _currentMom = _momKey>>
				<</if>>
			<</if>>

			<tr class="item">
				<td class="min25">
					<span @class="_genderClass + _customColorStyle">
						<span data-balloon-length="medium" @aria-label="'Mother: ' + (_motherNpc ? _motherNpc.name : (_motherAway || '????')) + ''" data-balloon-pos="up-left">
							<<link _nursery.name>>
								<<unset $guestId, $charId, $slaveId>>
								<<set $childId = _realIdx>>
								<<set $tmpGirl = _nursery>>
								<<set $tmpGirlBack = 'Nursery'>>
								<<set $tmpGirlViewBack = 'Child view'>>
								<<goto 'Child view'>>
							<</link>>
						</span>
					</span>
					<<=setup.npcListInfo(_nursery)>>
					<<if setup.getAge(_nursery) >= 5 && ($player.quests.school_built ?? false)>>
						<span data-balloon-length="medium" @aria-label="'Student: ' + _nursery.teach" data-balloon-pos="up-left">
							&#x1F392;
						</span>
					<</if>>
				</td>
				<td>
					<span data-balloon-length="medium" @aria-label="'Born: ' + (_nursery ? _nursery.birthDate.toDateString() : '????') + ((_nursery.birthDate.getDate() == $gameDate.getDate() && _nursery.birthDate.getMonth() == $gameDate.getMonth()) ?  '. &#x1F381; Happy Birthday! &#x1F476; ' : '')" data-balloon-pos="up-left">
						Age: <<=setup.getAge(_nursery)>>
					</span>
				</td>
				<td class="throw-out">
					<<link 'Throw out'>>
					  <<dialog 'Throw out'>>
						  Are you sure you want to throw <<=(_nursery.gender ? 'him' : 'her')>> out?
						  <br />
						  <<link 'Yes' 'Nursery'>>
							<<set _nurseryI = _realIdx >>
							<<run $nursery.splice(_nurseryI, 1)>>
							<<dialogclose>>
							<<set $player.goodwill -= 2>>
						  <</link>>	
					  <</dialog>>
					<</link>>
				</td>
			</tr>
		<</capture>>
	<</for>>
	</table>
<</if>>

<style>
	.min25 {
		min-width: 25%;
	}

	.throw-out {
    	width: 29%;
	}
</style>

[[Back|Youth district]]


