:: Church encounter - after punishment
/* Back from NPC punish after a church encounter: the guest goes back to where they were */
<<if $oldTmpGirlLocation>>
	<<set $tmpGirl.location = $oldTmpGirlLocation>>
	<<unset $oldTmpGirlLocation>>
<</if>>
<<set $tmpGirlViewBack = 'NPC view - guest'>>
<<goto 'NPC view - guest'>>
