:: Laura - date
<h1 class="ptitle">LAURA</h1>
<br /><br />
<<laura>>
    A date? Hm... What did you have in mind?
<</laura>>
<br />
<<link 'Pick berries in the woods'>>
    <<goto 'Laura - date \[berries\]'>>
<</link>>
<<if ($game.location.school ?? false)>>
    <<if recall($suppCode)>>
        <<link 'Walk around the settlement'>>
            <<set $player.companionsHome = $player.companions>>
            <<run setup.companions.clear()>>
            <<goto 'Laura - date \[settlement walk\]'>>
        <</link>>
    <<else>>
        <div class="link-internal disabled" style="background: #ccc">
            Walk around the settlement
            <<notPatreonIcon>>
        </div>
    <</if>>
<</if>>
<<if recall($suppCode)>>
    <<if timeBetween('18:00', '21:00')>>
        <<link 'Party night'>>
            <<set $player.companionsHome = $player.companions>>
            <<run setup.companions.clear()>>
            <<goto 'Laura - date \[party\]'>>
        <</link>>
    <<else>>
        <div class="link-internal" style="background: #ccc">
            Party night
        </div>
    <</if>>
    <<linkdesc>>
        Time between 18:00-21:00
    <</linkdesc>>
<<else>>
    <div class="link-internal disabled" style="background: #ccc">
        Party night
        <<notPatreonIcon>>
    </div>
<</if>>
<<link 'Leave'>>
    <<goto 'Laura - lab talk'>>
<</link>>
