:: NPC foursome choose [sex no-redirect girlview]

<<set _eligible = [], _foursomeLoc = $tmpGirl.location>>

<<if _foursomeLoc === 'church'>>
	<<for _fci, _fcg range $guests>>
		<<if _fcg.id === $tmpGirl.id || _fcg.gender !== 0 || !(_fcg.likesGuys ?? true) || (_fcg.horny ?? 0) < 20 || setup.getAge(_fcg) < 18>><<continue>><</if>>
		<<if _fcg.assignedTo !== 'church' || !setup.isAtWork(_fcg, $weather)>><<continue>><</if>>
		<<if !setup.percentageChance(setup.sexChance(_fcg))>><<continue>><</if>>
		<<run _eligible.push({type: 'guest', id: _fci})>>
	<</for>>
	<<for _fci, _fcg range $slaves>>
		<<if _fcg.id === $tmpGirl.id || _fcg.gender !== 0 || !(_fcg.likesGuys ?? true) || (_fcg.horny ?? 0) < 20 || setup.getAge(_fcg) < 18>><<continue>><</if>>
		<<if _fcg.assignedTo !== 'church' || !setup.isAtWork(_fcg, $weather)>><<continue>><</if>>
		<<if !setup.percentageChance(setup.sexChance(_fcg))>><<continue>><</if>>
		<<run _eligible.push({type: 'slave', id: _fci})>>
	<</for>>

<<elseif _foursomeLoc === 'hospital'>>
	<<for _fci, _fcg range $guests>>
		<<if _fcg.id === $tmpGirl.id || _fcg.gender !== 0 || !(_fcg.likesGuys ?? true) || (_fcg.horny ?? 0) < 20 || setup.getAge(_fcg) < 18>><<continue>><</if>>
		<<if !(_fcg.assignedTo === 'hospital' && setup.isAtWork(_fcg, $weather)) && typeof _fcg.sick === 'undefined'>><<continue>><</if>>
		<<if !setup.percentageChance(setup.sexChance(_fcg))>><<continue>><</if>>
		<<run _eligible.push({type: 'guest', id: _fci})>>
	<</for>>
	<<for _fci, _fcg range $slaves>>
		<<if _fcg.id === $tmpGirl.id || _fcg.gender !== 0 || !(_fcg.likesGuys ?? true) || (_fcg.horny ?? 0) < 20 || setup.getAge(_fcg) < 18>><<continue>><</if>>
		<<if typeof _fcg.sick === 'undefined'>><<continue>><</if>>
		<<if !setup.percentageChance(setup.sexChance(_fcg))>><<continue>><</if>>
		<<run _eligible.push({type: 'slave', id: _fci})>>
	<</for>>

<<elseif _foursomeLoc === 'bathhouse'>>
	<<for _fci, _fcg range $guests>>
		<<if _fcg.id === $tmpGirl.id || _fcg.gender !== 0 || !(_fcg.likesGuys ?? true) || (_fcg.horny ?? 0) < 20 || setup.getAge(_fcg) < 18>><<continue>><</if>>
		<<set _fBsd = setup.bathSchedule[_fcg.assignedTo]>>
		<<if _fBsd && !timeBetween(_fBsd.from, _fBsd.to)>><<continue>><</if>>
		<<if !setup.percentageChance(setup.sexChance(_fcg))>><<continue>><</if>>
		<<run _eligible.push({type: 'guest', id: _fci})>>
	<</for>>

<<else>>
	/* Default: all guests */
	<<for _fci, _fcg range $guests>>
		<<if _fcg.id === $tmpGirl.id || _fcg.gender !== 0 || !(_fcg.likesGuys ?? true) || (_fcg.horny ?? 0) < 20 || setup.getAge(_fcg) < 18>><<continue>><</if>>
		<<if !setup.percentageChance(setup.sexChance(_fcg))>><<continue>><</if>>
		<<run _eligible.push({type: 'guest', id: _fci})>>
	<</for>>
<</if>>

<<if _eligible.length < 2>>
	Not enough willing participants right now.
	<br /><br />
	<<link 'Back'>>
		<<goto 'NPC fuck choose'>>
	<</link>>
<<else>>
	<<if typeof $foursomePickedFirst === 'undefined'>>
		Choose the first partner:
		<br /><br />
		<table id="slaves" class="npc-list">
		<<for _fentry range _eligible>>
			<<capture _fentry>>
				<<set _fnpc = _fentry.type === 'guest' ? $guests[_fentry.id] : $slaves[_fentry.id]>>
				<tr class="item">
					<td>
						<<=setup.displayName(_fnpc)>> <<=setup.npcListInfo(_fnpc)>>
					</td>
					<td>
						<<link 'Choose'>>
							<<set $foursomePickedFirst = _fentry>>
							<<goto 'NPC foursome choose'>>
						<</link>>
					</td>
				</tr>
			<</capture>>
		<</for>>
		</table>
	<<else>>
		<<set _remaining = _eligible.filter(function(e) { return !(e.type === $foursomePickedFirst.type && e.id === $foursomePickedFirst.id); })>>
		<<set _fpFirstNpc = $foursomePickedFirst.type === 'guest' ? $guests[$foursomePickedFirst.id] : $slaves[$foursomePickedFirst.id]>>
		<<if _remaining.length < 1>>
			Not enough willing participants left.
			<br /><br />
			<<link 'Back'>>
				<<unset $foursomePickedFirst>>
				<<goto 'NPC fuck choose'>>
			<</link>>
		<<else>>
			First partner: <strong><<=setup.displayName(_fpFirstNpc)>></strong>
			<br />
			Choose the second partner:
			<br /><br />
			<table id="slaves" class="npc-list">
			<<for _rentry range _remaining>>
				<<capture _rentry, _fpFirstNpc>>
					<<set _rnpc = _rentry.type === 'guest' ? $guests[_rentry.id] : $slaves[_rentry.id]>>
					<tr class="item">
						<td>
							<<=setup.displayName(_rnpc)>> <<=setup.npcListInfo(_rnpc)>>
						</td>
						<td>
							<<link 'Choose'>>
								<<if $foursomePickedFirst.type === 'guest'>>
									<<set $guestId2 = $foursomePickedFirst.id>>
									<<unset $slaveId2, $charId2>>
								<<else>>
									<<set $slaveId2 = $foursomePickedFirst.id>>
									<<unset $guestId2, $charId2>>
								<</if>>
								<<set $tmpGirl2 = _fpFirstNpc>>
								<<if _rentry.type === 'guest'>>
									<<set $guestId3 = _rentry.id>>
									<<unset $slaveId3, $charId3>>
								<<else>>
									<<set $slaveId3 = _rentry.id>>
									<<unset $guestId3, $charId3>>
								<</if>>
								<<set $tmpGirl3 = _rentry.type === 'guest' ? $guests[_rentry.id] : $slaves[_rentry.id]>>
								<<unset $foursomePickedFirst, $charId, $slaveId>>
								<<set $tmpGirlViewBack = 'NPC view - guest'>>
								<<foursome $tmpGirl $tmpGirl2 $tmpGirl3>>
							<</link>>
						</td>
					</tr>
				<</capture>>
			<</for>>
			</table>
			<<link 'Pick someone else'>>
				<<unset $foursomePickedFirst>>
				<<goto 'NPC foursome choose'>>
			<</link>>
		<</if>>
	<</if>>
<</if>>
<br /><br />
<<link 'Back'>>
	<<unset $foursomePickedFirst>>
	<<goto 'NPC fuck choose'>>
<</link>>
