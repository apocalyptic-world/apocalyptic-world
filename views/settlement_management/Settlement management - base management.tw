:: Settlement management - Base management
<h1 class="ptitle">
    BASE MANAGEMENT
</h1>

<<set _electricityTotal = setup.baseManagement.electricity.total()>>
<<set _electricityTotalOutput = _electricityTotal>>
<<if _electricityTotal > 0>>
    <<set _electicityClass = 'green'>>
    <<set _electricityTotalOutput = '+' + _electricityTotal>>
<<elseif _electricityTotal < 0>>
    <<set _electicityClass = 'red'>>
    <<set _electricityTotalOutput = _electricityTotal>>
<</if>>
<div id="base-management">
    <div class="base-management-item">
        <h3>Energy [<span @class="''+ _electicityClass  +''"><<=_electricityTotalOutput>></span>]</h3>
        <table>
            <tr>
                <td>Produced:</td>
                <td class="green"><<=setup.baseManagement.electricity.production()>></td>
            </tr>
            <tr>
                <td>Consumed:</td>
                <td class="red"><<=setup.baseManagement.electricity.consumption()>></td>
            </tr>
            <tr>
                <td>Storage:</td>
                <td><<=setup.baseManagement.electricity.storage()>>/<<=setup.baseManagement.electricity.storageMax()>></td>
            </tr>
        </table>
    </div>
    <div class="base-management-item">
        <h3>Defense</h3>
        <table>
            <tr>
                <td><<=setup.baseManagement.defense.description()>></td>
            </tr>
        </table>
    </div>
    <div class="base-management-item">
        <h3>Population</h3>
        <table>
            <tr>
                <td colspan="2"><<=setup.baseManagement.population.description()>> (<<=$player.baseManagement?.settlersFemales ?? 0>> of them female)</td>
            </tr>
            <tr>
                <td>Living houses:</td>
                <td><strong><<=setup.baseManagement.population.livingHousesCount()>></strong></td>
            </tr>
            <tr>
                <td style="font-size: 11px; colspan:2; text-align:right" > <<= ( ( (setup.baseManagement.population.livingHousesCount()*3) <= (setup.baseManagement.population.settlersCount() + 5) )  ?  '&#x26A0;' : '')>> (Capacity: <strong><<=setup.baseManagement.population.livingHousesCount() * 3>></strong> settlers)</td>
            </tr>
        </table>
    </div>
    <div class="base-management-item">
        <h3>Materials</h3>
        <table>
            <tr>
                <td>Metal:</td>
                <td><strong><<=setup.cabinInventory.count('metal')>></strong></td>
            </tr>
            <tr>
                <td>Wood:</td>
                <td><strong><<=setup.cabinInventory.count('wood')>></strong></td>
            </tr>
            <tr>
                <td>Plastic:</td>
                <td><strong><<=setup.cabinInventory.count('plastic')>></strong></td>
            </tr>
            <tr>
                <td>Glass:</td>
                <td><strong><<=setup.cabinInventory.count('glass')>></strong></td>
            </tr>
            <tr>
                <td>Rope:</td>
                <td><strong><<=setup.cabinInventory.count('rope')>></strong></td>
            </tr>
            <tr>
                <td>Solar Panel (not installed):</td>
                <td><strong><<=setup.cabinInventory.count('solar_panel')>></strong></td>
            </tr>
            <tr>
                <td>Stone:</td>
                <td><strong><<=setup.cabinInventory.count('stone')>></strong></td>
            </tr>
            <tr>
                <td>Coal:</td>
                <td><strong><<=setup.cabinInventory.count('coal')>></strong></td>
            </tr>
        </table>
    </div>
    <<set _hospitalCount = $player?.baseManagement?.buildings?.hospital ?? 0>>
    <<set _milkBarnCount = $player?.baseManagement?.buildings?.milk_barn ?? 0>>
    <<set _freezerCount  = $player?.baseManagement?.buildings?.freezer  ?? 0>>
    <<if _hospitalCount > 0 || _milkBarnCount > 0 || _freezerCount > 0>>
    <div class="base-management-item">
        <h3>Non-Residences Consuming Energy</h3>
        <table>
            <<if _hospitalCount > 0>>
            <tr>
                <td class="base-building-img" style="width:25%">
					[img[setup.ImagePath+'base_management/hospital.jpg']]
				  </td>
                <td>Hospital (<<=_hospitalCount>>):</td>
                <td class="red"><<=_hospitalCount * 5>></td>
            </tr>
            <</if>>
            <<if _milkBarnCount > 0>>
            <tr>
                <td class="base-building-img" style="width:25%">
					[img[setup.ImagePath+'base_management/milk_barn.jpg']]
				  </td>
                <td>Milk Barn (<<=_milkBarnCount>>):</td>
                <td class="red"><<=_milkBarnCount * 5>></td>
            </tr>
            <</if>>
            <<if _freezerCount > 0>>
            <tr>
                <td class="base-building-img" style="width:25%">
					[img[setup.ImagePath+'base_management/freezer.jpg']]
				  </td>
                <td>Freezer (<<=_freezerCount>>):</td>
                <td class="red"><<=_freezerCount * 3>></td>
            </tr>
            <</if>>
        </table>
    </div>
    <</if>>
</div>
<h2>Buildings</h2>
<<include 'Settlement management buildings'>>
<<run window.buildMultipliers = {}; window.buildRequirements = {};>>
<<for _baseBuildingName, _baseBuilding range _managementBuildings>>
    <<set _required to Object.keys(_baseBuilding.required)>>
    <<set _workEnergy = _baseBuilding.energy>>
    <<capture _baseBuildingName, _baseBuilding, _required, _workEnergy>>
        <<if !_baseBuilding.show>>
            <<continue>>
        <</if>>
        <<set _maxBuild = Math.floor($player.energy / _baseBuilding.energy)>>
        <<set _itemHasResources = true>>
	  <div class="base-management-building-item" @data-building="_baseBuildingName">
		  <table>
			  <tr>
                <td class="base-building-img">
					[img[setup.ImagePath+'base_management/'+_baseBuildingName+'.jpg']]
				  </td>
				  <td style="width: 57%">
					  <h3><<=_baseBuilding.title>></h3>
					  <<=_baseBuilding.description>>
					  <br />
                      <<if _baseBuilding.currentCount >>
                        <<if _baseBuilding.currentTitle>>
                            <<=_baseBuilding.currentTitle>>:
                        <<else>>
                            Current count:
                        <</if>>
					    <<=$player?.baseManagement?.buildings[_baseBuildingName] ?? 0>><<if _baseBuilding.percentage>>%<</if>>
                      <</if>>
				  </td>
				  <td style="width: 20%">
					  <div class="base-management-building-required">
						  Required:<br />
						  <<for _r to 0; _r lt _required.length; _r++>>
						  	  <<set _reqKey   = _required[_r]>>
							  <<set _reqCount = _baseBuilding.required[_reqKey]>>
                              <<set _hasCount = setup.cabinInventory.count(_reqKey)>>
							  <<set _maxBuild = Math.min(_maxBuild, Math.floor(_hasCount / _reqCount))>>
							  <<set _needtxt = ''>>

							  <<if _hasCount < _reqCount>>
								  <<set _itemHasResources = false>>
								  <<set _needtxt = '(missing ' + (_reqCount - _hasCount) + ')'>>
							  <</if>>
							  <span @class="_hasCount < _reqCount ? 'req-insufficient' : ''"><span class="req-amount" @data-req-key="_reqKey" @data-req-base="_baseBuilding.required[_reqKey]"><<=_reqCount>></span> <<=Item.get(_reqKey).name>> <span class="req-missing"><<=_needtxt>></span></span><br />
						  <</for>>
						  <span @class="$player.energy < _baseBuilding.energy ? 'req-insufficient' : ''"><span class="req-amount" @data-energy-base="_baseBuilding.energy"><<=_baseBuilding.energy>></span> energy</span>
						  <<if $player.energy < _baseBuilding.energy>>
					   	  	<<set _itemHasResources = false>>
						  <</if>>
						  <<run window.buildRequirements[_baseBuildingName] = {max: _maxBuild, energy: _baseBuilding.energy, minutes: _baseBuilding.minutes || 0, materials: Object.assign({}, _baseBuilding.required)};>>
					  </div>
				  </td>
				  <td style="width: 10%">
                    <<if _baseBuilding.int && $player.int < _baseBuilding.int>>
                        <div class="workbench-not-enough">
                            Not enough intelligence
                        </div>
					<<elseif timeBetween('08:00', '23:59')>>
						<span class="build-link-wrap" @style="_itemHasResources ? '' : 'display:none'">
							<<link 'Build'>>
								<<set _buildMult = (window.buildMultipliers?.[_baseBuildingName] ?? 1)>>
								<<energy `-_workEnergy * _buildMult`>>
								<<for _r to 0; _r lt _required.length; _r++>>
									<<capture _r>>
	                                    <<set _reqKey   = _required[_r]>>
	                                    <<set _reqCount = _baseBuilding.required[_reqKey] * _buildMult>>
	                                    <<run setup.cabinInventory.drop(_reqKey, _reqCount)>>
									<</capture>>
								<</for>>
	                            <<if _baseBuilding.minutes>>
	                                <<addmins `_baseBuilding.minutes * _buildMult`>>
	                            <</if>>
								<<for _mi to 0; _mi lt _buildMult; _mi++>>
									<<run _baseBuilding.after()>>
								<</for>>
								<<goto _baseBuilding.goto>>
							<</link>>
						</span>
						<div class="workbench-not-enough build-not-enough-dyn" @style="_itemHasResources ? 'display:none' : ''">
							Not enough resources
						</div>
						<<if _baseBuilding.currentCount>>
							<div class="build-multiplier">
								<button class="mult-btn mult-decr" disabled onclick="adjustBuildMult(this, -1)">−</button>
								<span class="mult-value">×1</span>
								<<if _maxBuild > 1>>
									<button class="mult-btn mult-incr" onclick="adjustBuildMult(this, 1)">+</button>
								<<else>>
									<button class="mult-btn mult-incr" disabled onclick="adjustBuildMult(this, 1)">+</button>
								<</if>>
							</div>
						<</if>>
						<<if _baseBuilding.minutes>>
							<div class="build-time-cost"><span class="build-time-value"><<=_baseBuilding.minutes>></span> min</div>
						<</if>>
					  <<else>>
                            <div class="workbench-not-enough">
                                Too late for building
                            </div>
					  <</if>>
				  </td>
			  </tr>
		  </table>
	  </div>
	<</capture>>
<</for>>

<script>
    window.adjustBuildMult = function(btn, delta) {
        var bldg = btn.closest('.base-management-building-item');
        if (!bldg) return;
        var key = bldg.dataset.building;
        var reqs = window.buildRequirements && window.buildRequirements[key];
        var max = reqs ? reqs.max : 1;
        var curr = window.buildMultipliers[key] || 1;
        var next = Math.max(1, Math.min(max, curr + delta));
        window.buildMultipliers[key] = next;
        window.refreshBuildMult(bldg, next);
    };

    window.refreshBuildMult = function(bldg, mult) {
        var key = bldg.dataset.building;
        var reqs = window.buildRequirements && window.buildRequirements[key];
        if (!reqs) return;

        var max = reqs.max;
        bldg.querySelector('.mult-value').textContent = '×' + mult;

        var decrBtn = bldg.querySelector('.mult-decr');
        var incrBtn = bldg.querySelector('.mult-incr');
        if (decrBtn) decrBtn.disabled = mult <= 1;
        if (incrBtn) incrBtn.disabled = mult >= max;

        var allOk = mult <= max;
        var buildWrap = bldg.querySelector('.build-link-wrap');
        var notEnough = bldg.querySelector('.build-not-enough-dyn');
        if (buildWrap) buildWrap.style.display = allOk ? '' : 'none';
        if (notEnough) notEnough.style.display  = allOk ? 'none' : '';

        var timeSpan = bldg.querySelector('.build-time-value');
        if (timeSpan && reqs.minutes) timeSpan.textContent = reqs.minutes * mult;
    };
</script>

<style>
    #base-management {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
        gap: 10px;
        margin-bottom: 10px;
    }

    #base-management > div {
        background-color: #5b5b5b;
        box-shadow: 5px 5px 5px #000;
        padding: 10px;
        max-width: 100%;
    }

    #base-management table {
        width: 100%;
    }

    #base-management .green {
        color: #2AFF00;
    }

    #base-management .red {
        color: red;
    }

    .base-building-img img {
        width: 100px;
    }

    .base-management-building-item {
        background: #5b5b5b;
        box-shadow: 5px 5px 5px #000;
        padding: 5px;
        font-size: 11px;
    }

    .base-management-building-item td {
        padding: 5px;
    }

    .req-insufficient {
        color: red;
    }

    .build-multiplier {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 3px;
        margin-top: 5px;
    }

    .mult-btn {
        background: #3a3a3a;
        border: 1px solid #777;
        color: #ccc;
        cursor: pointer;
        width: 18px;
        height: 18px;
        padding: 0;
        font-size: 14px;
        line-height: 1;
        text-align: center;
        border-radius: 2px;
    }

    .mult-btn:hover:not(:disabled) {
        background: #555;
        border-color: #aaa;
    }

    .mult-btn:disabled {
        opacity: 0.3;
        cursor: default;
    }

    .mult-value {
        font-size: 11px;
        min-width: 22px;
        text-align: center;
        color: #ccc;
    }

    .build-time-cost {
        font-size: 10px;
        text-align: center;
        color: #aaa;
        margin-top: 3px;
    }
</style>
