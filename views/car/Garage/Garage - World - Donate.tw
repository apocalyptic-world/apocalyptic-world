:: Garage - World - Donate [Place bg-garage settlement]
<h1 class="ptitle">DONATE</h1>
<br />

<<set _dnS = setup.settlements.getById($tmpSettlement)>>
<<if !_dnS>><<goto 'Garage - World'>><</if>>

<<set _dnConfig = setup.settlements.typeConfig[_dnS.type]>>
<<set _dnWants  = _dnConfig.wantsGoods ?? []>>
<<set _dnRelColors = { hostile: '#e05555', unfriendly: '#e09855', neutral: '#999999', friendly: '#55cc88', allied: '#5599e0' }>>
<<set _dnRelLevel  = setup.settlements.getRelationshipLevel(_dnS)>>
<<set _dnRelColor  = _dnRelColors[_dnRelLevel]>>

<<if !$tmpDonateOpen>>
	<<set $tmpDonateOpen = true>>
	<<addmins 30>>
<</if>>

<<script>>
window.awDonate = function(btn) {
	var idx     = btn.dataset.idx;
	var item    = btn.dataset.item;
	var maxHave = parseInt(btn.dataset.have) || 0;
	var qtyEl   = document.getElementById('dn_qty_' + idx);
	var qty     = Math.max(1, Math.min(Math.floor(Number(qtyEl ? qtyEl.value : 1) || 1), maxHave));

	var s  = setup.settlements.getById(variables().tmpSettlement);
	var bp = variables().backpack;
	if (!s || !bp || bp.count(item) < qty) return;

	bp.drop(item, qty);
	s.resources[item] = (s.resources[item] || 0) + qty;
	setup.settlements.modifyRelationship(s, 8 * qty, 'Donated needed supplies');
	setup.settlements.save(setup.settlements.getAll());

	Engine.play('Garage - World - Donate');
};
<</script>>
You haul out your supplies and spread them in front of <<= _dnS.name>>. No deal, no strings — just goodwill.
<br /><br />

<span style="color: <<= _dnRelColor>>; font-size: 0.9em;">◈ Currently <<= setup.settlements.getRelationshipLabel(_dnS)>></span>
<br /><br />

<div style="background: rgba(0,0,0,0.12); border-left: 3px solid #444; padding: 8px 14px; margin-bottom: 14px; font-size: 0.82em; color: #666;">
	Donating items they actually need gives a larger relationship boost.
</div>

<<set _dnHasAny = false>>
<<for _dni = 0; _dni < _dnWants.length; _dni++>>
	<<set _dnItem = _dnWants[_dni]>>
	<<set _dnHave = $backpack.count(_dnItem)>>
	<<if _dnHave > 0>>
		<<set _dnHasAny = true>>
		<<capture _dni, _dnItem, _dnHave>>
			<div id="dn_item_<<= _dni>>" style="padding: 8px 0; border-bottom: 1px solid #1c1c1c; display:flex; align-items:center; gap:8px;">
				<span style="flex:1; min-width:120px;"><<= (Item.get(_dnItem)?.name ?? _dnItem.replace(/_/g, ' '))>> <span style="color:#666;">(have <<= _dnHave>>)</span></span>
				<input type="number" @id="'dn_qty_' + _dni" value="1" min="1" @max="_dnHave" style="background:#222;color:#eee;border:1px solid #555;width:55px;padding:2px 4px;flex:none;">
				<span style="flex:none;"><a href="javascript:void(0)" class="link-internal" @data-idx="_dni" @data-item="_dnItem" @data-have="_dnHave" onclick="window.awDonate(this)">Donate</a></span>
			</div>
		<</capture>>
	<</if>>
<</for>>

<<if !_dnHasAny>>
	<p style="color: #888; font-size: 0.9em;">You don't have anything they need right now.</p>
<</if>>

<br />
<<link 'Leave'>>
	<<set $tmpDonateOpen = false>>
	<<goto 'Garage - World - Settlement'>>
<</link>>
