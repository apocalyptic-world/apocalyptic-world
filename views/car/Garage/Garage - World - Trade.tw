:: Garage - World - Trade [Place bg-garage settlement]
<h1 class="ptitle">TRADE</h1>
<br />

<<set _trS = setup.settlements.getById($tmpSettlement)>>
<<if !_trS>><<goto 'Garage - World'>><</if>>

<<if !setup.settlements.canTrade(_trS)>>
	<p style="color: #e05555;">They're not willing to trade with you right now.</p>
	<<link 'Back'>><<goto 'Garage - World - Settlement'>><</link>>
<<else>>

<<if !$tmpTradeOpen>>
	<<set $tmpTradeOpen = true>>
	<<addmins 30>>
<</if>>

<<script>>
window.awBuy = function(btn) {
	var idx   = btn.dataset.idx;
	var item  = btn.dataset.item;
	var price = parseInt(btn.dataset.price) || 0;
	var stock = parseInt(btn.dataset.stock) || 0;
	var qtyEl = document.getElementById('tr_bq_' + idx);
	var qty   = Math.max(1, Math.min(Math.floor(Number(qtyEl ? qtyEl.value : 1) || 1), stock));

	var s  = setup.settlements.getById(variables().tmpSettlement);
	var pl = variables().player;
	if (!s || pl.money < price * qty || (s.resources[item] || 0) < qty) return;

	pl.money -= price * qty;
	variables().backpack.pickup(item, qty);
	s.resources[item] = Math.max(0, (s.resources[item] || 0) - qty);
	setup.settlements.modifyRelationship(s, qty, 'Trade');
	setup.settlements.save(setup.settlements.getAll());
	Engine.play('Garage - World - Trade');
};

window.awSell = function(btn) {
	var idx   = btn.dataset.idx;
	var item  = btn.dataset.item;
	var price = parseInt(btn.dataset.price) || 0;
	var have  = parseInt(btn.dataset.have) || 0;
	var qtyEl = document.getElementById('tr_sq_' + idx);
	var qty   = Math.max(1, Math.min(Math.floor(Number(qtyEl ? qtyEl.value : 1) || 1), have));

	var s  = setup.settlements.getById(variables().tmpSettlement);
	var bp = variables().backpack;
	if (!s || !bp || bp.count(item) < qty) return;

	bp.drop(item, qty);
	variables().player.money += price * qty;
	s.resources[item] = (s.resources[item] || 0) + qty;
	setup.settlements.modifyRelationship(s, 2 * qty, 'Sold wanted goods');
	setup.settlements.save(setup.settlements.getAll());
	Engine.play('Garage - World - Trade');
};
<</script>>

<<set _trOffer = setup.settlements.getTradeOffer(_trS)>>
<<set _trWants = setup.settlements.getWantsOffer(_trS)>>

<span style="color: #aaa; font-size: 0.88em;">Your caps: <strong style="color: #e0c055;"><<=$player.money>></strong></span>
<br /><br />

<h3 style="color: #ccc; margin: 0 0 8px 0; padding-bottom: 4px; border-bottom: 1px solid #2a2a2a;">Buying from them</h3>

<<if _trOffer && _trOffer.length>>
	<<for _tBi = 0; _tBi < _trOffer.length; _tBi++>>
		<<set _trBItem  = _trOffer[_tBi].item>>
		<<set _trBQty   = _trOffer[_tBi].quantity>>
		<<set _trBPrice = _trOffer[_tBi].priceEach>>
		<<capture _tBi, _trBItem, _trBQty, _trBPrice>>
			<div id="tr_b_<<= _tBi>>" style="padding: 8px 0; border-bottom: 1px solid #1c1c1c; display:flex; align-items:center; gap:8px;">
				<span style="flex:1; min-width:140px;"><<= _trBItem.replace(/_/g, ' ')>> — <<= _trBPrice>> caps ea. <span style="color:#555; font-size:0.78em;">(<<= _trBQty>> in stock)</span></span>
				<input type="number" @id="'tr_bq_' + _tBi" value="1" min="1" @max="_trBQty" style="background:#222;color:#eee;border:1px solid #555;width:55px;padding:2px 4px;flex:none;">
				<span style="flex:none;"><a href="javascript:void(0)" class="link-internal" @data-idx="_tBi" @data-item="_trBItem" @data-price="_trBPrice" @data-stock="_trBQty" onclick="window.awBuy(this)">Buy</a></span>
			</div>
		<</capture>>
	<</for>>
<<else>>
	<span style="color: #888; font-size: 0.9em;">Nothing in stock right now.</span>
<</if>>

<br />
<h3 style="color: #ccc; margin: 16px 0 8px 0; padding-bottom: 4px; border-bottom: 1px solid #2a2a2a;">Selling to them</h3>
<p style="color: #666; font-size: 0.82em; margin: 0 0 8px 0;">They pay above market rate for items they need.</p>

<<set _tSHasAny = false>>
<<for _tSi = 0; _tSi < _trWants.length; _tSi++>>
	<<set _tSwItem  = _trWants[_tSi].item>>
	<<set _tSwPrice = _trWants[_tSi].priceEach>>
	<<set _tSwHave  = $backpack.count(_tSwItem)>>
	<<if _tSwHave > 0>>
		<<set _tSHasAny = true>>
		<<capture _tSi, _tSwItem, _tSwPrice, _tSwHave>>
			<div id="tr_s_<<= _tSi>>" style="padding: 8px 0; border-bottom: 1px solid #1c1c1c; display:flex; align-items:center; gap:8px;">
				<span style="flex:1; min-width:140px;"><<= _tSwItem.replace(/_/g, ' ')>> — <<= _tSwPrice>> caps ea. <span style="color:#aaa; font-size:0.78em;">(you have <<= _tSwHave>>)</span></span>
				<input type="number" @id="'tr_sq_' + _tSi" value="1" min="1" @max="_tSwHave" style="background:#222;color:#eee;border:1px solid #555;width:55px;padding:2px 4px;flex:none;">
				<span style="flex:none;"><a href="javascript:void(0)" class="link-internal" @data-idx="_tSi" @data-item="_tSwItem" @data-price="_tSwPrice" @data-have="_tSwHave" onclick="window.awSell(this)">Sell</a></span>
			</div>
		<</capture>>
	<</if>>
<</for>>
<<if !_tSHasAny>>
	<span style="color: #888; font-size: 0.9em;">You don't have anything they want right now.</span>
<</if>>

<br /><br />
<<link 'Done'>>
	<<set $tmpTradeOpen = false>>
	<<goto 'Garage - World - Settlement'>>
<</link>>
<</if>>
