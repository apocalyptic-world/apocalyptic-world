:: sleepPregnantStrangers [include]

<<if ($pregnantStrangers ?? []).length>>
    /* A stranger who was later brought home already carries the pregnancy on her guest/slave copy */
    <<set $pregnantStrangers = $pregnantStrangers.filter(function (stranger) { return !(stranger.id && setup.getNpcById(stranger.id)); })>>

    <<for _psI = 0; _psI < $pregnantStrangers.length; _psI++>>
        <<set _psStranger = $pregnantStrangers[_psI]>>
        <<if typeof _psStranger.pregnancy_return_day === 'undefined'>>
            /* Half come back still pregnant, half come back carrying the baby */
            <<set _psStranger.pregnancy_return_day = (_psStranger.pregnancy_encounter_day ?? $game.day) + (setup.percentageChance(50) ? random(90, 200) : random(290, 400))>>
        <</if>>
        <<if typeof $strangerPregnancyHappening === 'undefined' && $game.day >= _psStranger.pregnancy_return_day>>
            <<set $strangerPregnancyHappening = _psI>>
        <</if>>
    <</for>>
<</if>>
