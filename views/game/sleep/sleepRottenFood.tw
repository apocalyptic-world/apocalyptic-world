:: sleepRottenFood [include]

<<if $game.foodRotten>>
    <<set _foodRottenNpcs = setup.npcs.pick($guests, randomInteger(1,3)).concat(setup.npcs.pick($slaves, randomInteger(1,3)))>>
    <<for _rottenFoodNpc range _foodRottenNpcs>>
        <<set _rottenFoodNpc.sick = {
            days: 2,
            desc: 'Food poisoning',
            id: 'food_poisoning'
        }>>
        <<run setup.sleepMessages.addMain(_rottenFoodNpc.name + ' got sick with food poisoning.')>>
    <</for>>
    <<run delete $game.foodRotten>>
<</if>>