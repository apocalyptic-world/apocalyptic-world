:: Achievements
<<if !$player.achievements>><<set $player.achievements = {}>><</if>>
<<set _achKeys = Object.keys(setup.achievements ?? {})>>
<<set _achTotal = _achKeys.length>>
<<set _achUnlocked = _achKeys.filter(k => $player.achievements[k] ?? false).length>>

<div class="ach-header">
	🏆 Achievements &nbsp;<span class="ach-count"><<=_achUnlocked>>/<<=_achTotal>></span>
</div>

<div class="ach-grid">
<<for _achId range _achKeys>><<capture _achId>>
	<<set _ach = setup.achievements[_achId]>>
	<<set _done = ($player.achievements[_achId] ?? false)>>
	<div @class="'ach-card' + (_done ? ' ach-done' : ' ach-locked')">
		<div class="ach-icon"><<=_ach.icon>></div>
		<div class="ach-name"><<=_ach.name>></div>
		<div class="ach-desc"><<if _done>><<=_ach.desc>><<else>>???<</if>></div><<if !_done && _ach.hint>><div class="ach-hint"><<=_ach.hint>></div><</if>>
	</div>
<</capture>><</for>>
</div>

<style>
.ach-header {
	font-size: 1.1em;
	font-weight: bold;
	margin-bottom: 12px;
}
.ach-count {
	font-size: 0.85em;
	opacity: 0.6;
}
.ach-grid {
	display: grid;
	grid-template-columns: repeat(3, 1fr);
	gap: 10px;
}
.ach-card {
	border: 1px solid #444;
	border-radius: 6px;
	padding: 10px 8px;
	text-align: center;
}
.ach-done {
	border-color: #888;
	background: #1e2a1e;
}
.ach-locked {
	border-color: #2a2a2a;
	background: #1a1a1a;
}
/* fade the locked card element by element, so the hint under the ??? stays readable */
.ach-locked .ach-icon,
.ach-locked .ach-name {
	opacity: 0.45;
}
.ach-locked .ach-desc {
	opacity: 0.35;
}
.ach-icon {
	font-size: 1.8em;
	margin-bottom: 4px;
}
.ach-name {
	font-size: 0.78em;
	font-weight: bold;
	margin-bottom: 4px;
	line-height: 1.2;
}
.ach-desc {
	font-size: 0.72em;
	opacity: 0.75;
	line-height: 1.3;
}
.ach-hint {
	font-size: 0.68em;
	font-style: italic;
	opacity: 0.6;
	line-height: 1.3;
	margin-top: 4px;
}
</style>
