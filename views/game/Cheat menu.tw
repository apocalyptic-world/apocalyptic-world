:: Cheat menu {"position":"29,1203","size":"100,100"}
<div id="ingame-ui-buttons-side" @class="'cheatmenu ' + settings.sidebarBackground + ''">
	<<link 'Change name'>>
		<<script>>Dialog.setup("Cheat menu - change MC name", "Cheat menu - change MC name"); Dialog.wiki(Story.get("Cheat menu - change MC name").processText()); Dialog.open();<</script>>
	<</link>>
	<<if recall($suppCode)>>
		<<if $player?.quests?.subDecayDisabled>>
			<<link 'Enable stat decay (Each day NPC submission and relationship lower)'>>
				<<set $player.quests.subDecayDisabled = false>>
				<<script>>Dialog.setup("Cheat menu", "Cheat menu"); Dialog.wiki(Story.get("Cheat menu").processText()); Dialog.open();<</script>>
			<</link>>
		<<else>>
			<<link 'Disable stat decay (Each day NPC submission and relationship lower)'>>
				<<set $player.quests.subDecayDisabled = true>>
				<<script>>Dialog.setup("Cheat menu", "Cheat menu"); Dialog.wiki(Story.get("Cheat menu").processText()); Dialog.open();<</script>>
			<</link>>
		<</if>>
	<</if>>
  	<<link 'Add 1000 caps'>>
	  	<<set $player.money += 1000>>
	  	<<goto `passage()`>>
  	<</link>>
  	<<link 'Add energy'>>
		<<set $player.energy = $player.maxEnergy>>
		<<goto `passage()`>>
	<</link>>
  	<<if recall($suppCode)>>
		<<link 'Increase max energy'>>
			<<set $player.maxEnergy +=10>>
			<<goto `passage()`>>
		<</link>>
	<</if>>
  <<link 'Add slave'>>
	  <<newgirl>>
	  <<run $slaves.push($tmpGirl)>>
	  <<goto 'Wood cabin'>>
  <</link>>
  	<<link 'Set all guest relationship to max'>>
		<<for _cheatGuestI, _cheatGuest range $guests>>
			<<set $guests[_cheatGuestI].relationship = 100>>
		<</for>>
		<<if typeof $guestId !== 'undefined' && $tmpGirl>>
			<<set $tmpGirl.relationship = 100>>
		<</if>>
		<<goto `passage()`>> 
	<</link>>
  <<if recall($suppCode)>>
	<<link 'Set all guest submission to max'>>
  		<<for _cheatGuestI, _cheatGuest range $guests>>
			<<set $guests[_cheatGuestI].sub = 100>>
		<</for>>
		<<if typeof $guestId !== 'undefined' && $tmpGirl>>
			<<set $tmpGirl.sub = 100>>
		<</if>>
		<<goto `passage()`>> 
  	<</link>>
	<<link 'Set all guest corruption to max'>>
  		<<for _cheatGuestI, _cheatGuest range $guests>>
			<<set $guests[_cheatGuestI].corruption = 100>>
		<</for>>
		<<if typeof $guestId !== 'undefined' && $tmpGirl>>
			<<set $tmpGirl.corruption = 100>>
		<</if>>
		<<goto `passage()`>> 
  	<</link>>
    <<link 'Set all slave relationship to max'>>
  		<<for _cheatslaveI, _cheatSlave range $slaves>>
			<<set $slaves[_cheatslaveI].relationship = 100>>
		<</for>>
		<<if typeof $slaveId !== 'undefined' && $tmpGirl>>
			<<set $tmpGirl.relationship = 100>>
		<</if>>
		<<goto `passage()`>> 
  	<</link>>
	<<link 'Set all slave submission to max'>>
  		<<for _cheatslaveI, _cheatSlave range $slaves>>
			<<set $slaves[_cheatslaveI].sub = 100>>
		<</for>>
		<<if typeof $slaveId !== 'undefined' && $tmpGirl>>
			<<set $tmpGirl.sub = 100>>
		<</if>>
		<<goto `passage()`>> 
  	<</link>>
	<<link 'Set all slave corruption to max'>>
  		<<for _cheatslaveI, _cheatSlave range $slaves>>
			<<set $slaves[_cheatslaveI].corruption = 100>>
		<</for>>
		<<if typeof $slaveId !== 'undefined' && $tmpGirl>>
			<<set $tmpGirl.corruption = 100>>
		<</if>>
		<<goto `passage()`>> 
  	<</link>>
	<<link 'Add food (x10)'>>
		<<pickup $backpack 'food' 10>>
		<<goto `passage()`>>
	<</link>>
	<<link 'Add growth potion'>>
		<<pickup $backpack 'growth_potion' 1>>
		<<goto `passage()`>>
	<</link>>
	<<link 'Add fuel'>>
		<<pickup $backpack 'fuel' 1>>
		<<goto `passage()`>>
	<</link>>
	<<link 'Add car part'>>
		<<pickup $backpack 'car_part' 1>>
		<<goto `passage()`>>
	<</link>>
	<<link 'Add revolver'>>
		<<pickup $backpack 'revolver' 1>>
		<<goto `passage()`>>
	<</link>>
	<<link 'Add revolver bullets (x10)'>>
		<<pickup $backpack 'bullet_revolver' 10>>
		<<goto `passage()`>>
	<</link>>
	<<link 'Add shotgun shells (x10)'>>
		<<pickup $backpack 'shotgun_shell' 10>>
		<<goto `passage()`>>
	<</link>>
	<<link 'Add tribe medallion'>>
		<<pickup $backpack 'tribe_medallion' 1>>
		<<goto `passage()`>>
	<</link>>
	<<link 'Add body armor'>>
		<<pickup $backpack 'body_armor' 1>>
		<<goto `passage()`>>
	<</link>>
  <</if>>
  <<link 'Add champagne bottle'>>
  	<<pickup $backpack 'champagne' 1>>
  	<<goto `passage()`>> 
  <</link>>
   <<link 'Add car battery'>>
  	<<pickup $backpack 'car_battery' 1>>
  	<<goto `passage()`>> 
  <</link>>
	<<link 'Add blueprint [Library]'>>
  	<<pickup $backpack 'blueprint_library' 1>>
  	<<goto `passage()`>> 
  <</link>>
  <<link 'Unlock Bathhouse & Hot tub'>>
  	<<pickup $backpack 'blueprint_hot_tub' 1>>
  	<<set $game.location.bathhouse = true>>
  	<<set $game.location.hottub = true>>
  	<<goto `passage()`>>
  <</link>>
  	<<link 'Add crossbow blueprint'>>
		<<pickup $backpack 'blueprint_crossbow' 1>>
	<</link>>
  <<link 'Add antibiotics'>>
  	<<pickup $backpack 'antibiotics' 1>>
	<<goto `passage()`>>
  <</link>>
  <<link 'Clear companion list'>>
  	<<set $player.companions = {}>>
  	<<goto `passage()`>>
  <</link>>
  <<link 'Increase guest house bed limit'>>
  	<<set $guesthouseLimit++>>
	<<goto `passage()`>>
  <</link>>
  	<<link 'Increase basement cell limit'>>
		<<set $basementLimit++>>
		<<goto `passage()`>>
	<</link>>
  <<link 'Edit player stats'>>
  	<<script>>
  		Dialog.setup("Cheatmenu - edit player", "Cheatmenu - edit player");
  		Dialog.wiki(Story.get("Cheatmenu - edit player").processText());
  		Dialog.open();
  	<</script>>
  <</link>>
	<<link `($player.cheatFreezeBeauty ? '✓' : '') + 'Freeze beauty decay'`>>
		<<set $player.cheatFreezeBeauty = !($player.cheatFreezeBeauty ?? false)>>
		<<goto `passage()`>>
	<</link>>
	<<link 'Set all guest beauty to 100'>>
		<<for _cheatMenuNpcI, _cheatMenuNpc range ($guests ?? [])>>
			<<set $guests[_cheatMenuNpcI].beauty = 100>>
		<</for>>
		<<goto `passage()`>>
	<</link>>
	<<link 'Set all slave beauty to 100'>>
		<<for _cheatMenuNpcI, _cheatMenuNpc range ($slaves ?? [])>>
			<<set $slaves[_cheatMenuNpcI].beauty = 100>>
		<</for>>
		<<goto `passage()`>>
	<</link>>
	<<link 'Increase happiness to max for all NPCs'>>
		<<for _cheatMenuNpcI, _cheatMenuNpc range ($slaves ?? [])>>
			<<set $slaves[_cheatMenuNpcI].happy = 100>>
		<</for>>
		<<for _cheatMenuNpcI, _cheatMenuNpc range ($guests ?? [])>>
			<<set $guests[_cheatMenuNpcI].happy = 100>>
		<</for>>
		<<if $tmpGirl ?? null>>
			<<set $tmpGirl.happy = 100>>
		<</if>>
		<<goto `passage()`>>
  	<</link>>
  <<if recall($suppCode)>>
  	<<set _cheatSkipLabel = 'Skip time (1 week)'>>
	<<linkreplace _cheatSkipLabel>>
		<<set _cheatSkipYes = 'Yes, skip a whole week (cannot be undone)'>>
		<<link _cheatSkipYes>>
			<<sleep>>
			<<sleep>>
			<<sleep>>
			<<sleep>>
			<<sleep>>
			<<sleep>>
			<<sleep>>
			<<goto `passage()`>>
		<</link>>
		<<set _cheatSkipNo = 'Cancel'>>
		<<link _cheatSkipNo>>
			<<goto `passage()`>>
		<</link>>
	<</linkreplace>>
	<<if typeof $tmpGirl !== 'undefined' && (typeof $slaveId !== 'undefined' || typeof $guestId !== 'undefined' || typeof $charId !== 'undefined' || typeof $childId !== 'undefined')>>
		<<link 'Edit NPC'>>
			<<script>>
				Dialog.setup("Cheatmenu - edit NPC", "Cheatmenu - edit NPC");
				Dialog.wiki(Story.get("Cheatmenu - edit NPC").processText());
				Dialog.open();
			<</script>>
		<</link>>
	<</if>>
	<<link 'Set NPC relationship (between guests)'>>
		<<script>>
			Dialog.setup("Cheatmenu - npc relationship between", "Cheatmenu - npc relationship between");
			Dialog.wiki(Story.get("Cheatmenu - npc relationship between").processText());
			Dialog.open();
		<</script>>
	<</link>>
  <</if>>


    <<if recall($suppCode)>>
		<<set _availableGuests = setup.getAvailablePersons18yo($guests ?? [])>>
		<fieldset>
			<legend>
				Trigger event
			</legend>
			<<link 'Explore: Toxic cave'>>
				<<goto 'Explore event - toxic cave'>>
				<<script>>Dialog.close();<</script>>
			<</link>>
			<<link 'Explore: Waterfall'>>
				<<goto 'Explore event: Waterfall'>>
				<<script>>Dialog.close();<</script>>
			<</link>>
			<<link 'Explore: mysterious scream'>>
				<<goto 'Explore event - mysterious scream'>>
				<<script>>Dialog.close();<</script>>
			<</link>>
			<<if (_availableGuests[0] ?? []).length >= 2 && ($game.location.bathhouse ?? false)>>
				<<link 'Bathhouse: Threesome'>>
					<<set $tmpEvent = {
						bathhouseThreesome: [
							'guest:' + _availableGuests[0][0],
							'guest:' + _availableGuests[0][1]
						]
					}>>
					<<goto 'Bathhouse - threesome'>>
					<<script>>Dialog.close();<</script>>
				<</link>>
			<</if>>
			<<if (_availableGuests[0] ?? []).length >= 0>>
				<<link 'Bedroom: Sleepover'>>
					<<set $tmpEvent = {
						id: _availableGuests[0][0]
					}>>
					<<goto 'Bedroom - sleepover'>>
					<<script>>Dialog.close();<</script>>
				<</link>>
			<</if>>
			<<link 'Event: Base attack - fight'>>
				<<goto 'Event: Base attack'>>
				<<script>>Dialog.close();<</script>>
			<</link>>

			<<link 'Event: Heat wave'>>
				<<set $weather = {
					weather: 'sun',
					heatWave: true,
					daysLeft: randomInteger(4,6)
				}>>
				<<goto 'Weather - Heat wave'>>
				<<script>>Dialog.close();<</script>>
			<</link>>

			<<link 'Event: Cold snap'>>
				<<set $weather = {
					weather: 'storm',
					coldSnap: true,
					daysLeft: randomInteger(6,10)
				}>>
				<<goto 'Weather - Cold snap'>>
				<<script>>Dialog.close();<</script>>
			<</link>>

			<<link 'Event: Sand storm'>>
				<<set $weather = {
					weather: 'storm',
					sandStorm: true,
					daysLeft: 1
				}>>
				<<goto 'Weather - Sand storm'>>
				<<script>>Dialog.close();<</script>>
			<</link>>
			<<link 'Event: Blair and Ashley visit'>>
				<<goto 'Blair - Ashley threesome'>>
				<<script>>Dialog.close();<</script>>
			<</link>>
			<<link 'Event: The Chain Road'>>
				<<goto 'Car explore event - The Chain Road'>>
				<<script>>Dialog.close();<</script>>
			<</link>>
			<<link 'Event: Fever in the house'>>
				<<run setup.fever.start(setup.fever.pool(), $game.day)>>
				<<goto 'Event - Fever in the house'>>
				<<script>>Dialog.close();<</script>>
			<</link>>
			<<link 'Event: Gone in the night (theft)'>>
				<<newgirl>>
				<<set $tmpGirl.relationship = -20>>
				<<set $game.betrayal = { npc: clone($tmpGirl), kind: 'theft', day: $game.day, loot: { type: 'caps', amount: 100 } }>>
				<<set $player.money = Math.max($player.money - 100, 0)>>
				<<unset $tmpGirl>>
				<<goto 'Event - Gone in the night'>>
				<<script>>Dialog.close();<</script>>
			<</link>>
			<<link 'Event: Gone in the night (sold intel)'>>
				<<newgirl>>
				<<set $tmpGirl.relationship = -20>>
				<<set $game.betrayal = { npc: clone($tmpGirl), kind: 'intel', day: $game.day, leak: { id: null, name: 'a hostile camp', prevRaidDay: 0 } }>>
				<<unset $tmpGirl>>
				<<goto 'Event - Gone in the night'>>
				<<script>>Dialog.close();<</script>>
			<</link>>
			<<link 'Event: Gone in the night (note)'>>
				<<newgirl>>
				<<set $tmpGirl.relationship = 10>>
				<<set $game.betrayal = { npc: clone($tmpGirl), kind: 'note', day: $game.day }>>
				<<unset $tmpGirl>>
				<<goto 'Event - Gone in the night'>>
				<<script>>Dialog.close();<</script>>
			<</link>>
			<<link 'Event: Loyalty trial'>>
				<<newgirl>>
				<<set $tmpGirl.relationship = 20>>
				<<set $tmpGirl.history = [{ event: 'recruited', day: $game.day, place: 'Test camp' }]>>
				<<run $guests.push($tmpGirl)>>
				<<set $game.loyaltyTrial = { guestId: $tmpGirl.id, settlementId: null }>>
				<<unset $tmpGirl>>
				<<goto 'Event - Loyalty trial'>>
				<<script>>Dialog.close();<</script>>
			<</link>>
			<<link 'Event: First words (makes a feral guest)'>>
				<<newgirl>>
				<<run $tmpGirl.traits.push('feral')>>
				<<set $tmpGirl.relationship = 60>>
				<<run $guests.push($tmpGirl)>>
				<<set $game.firstWords = { id: $tmpGirl.id }>>
				<<unset $tmpGirl>>
				<<goto 'Event - First words'>>
				<<script>>Dialog.close();<</script>>
			<</link>>
			<<link 'Event: Blair - Price on her head'>>
				<<unset $characters.blair.quests.bounty_day>>
				<<goto 'Blair [Event] - Price on her head'>>
				<<script>>Dialog.close();<</script>>
			<</link>>
			<<link 'Event: Blair - The small hours (makes her pregnant)'>>
				<<set $characters.blair.pregnancy ??= 150>>
				<<unset $characters.blair.quests.small_hours_kick_day, $characters.blair.quests.small_hours_day>>
				<<goto 'Blair [Event] - The small hours'>>
				<<script>>Dialog.close();<</script>>
			<</link>>
			<<link 'Event: Blair - House rules (needs an adult woman guest)'>>
				<<set _cheatHrIdx = $guests.findIndex(function (g) { return g.gender === 0 && setup.getAge(g) >= 18 && !(g.traits ?? []).includes('feral'); })>>
				<<if _cheatHrIdx >= 0>>
					<<set $guests[_cheatHrIdx].relationship = 80>>
				<</if>>
				<<unset $characters.blair.quests.house_rules_day>>
				<<goto 'Blair [Event] - House rules'>>
				<<script>>Dialog.close();<</script>>
			<</link>>
			<<link 'Event: Blair - Her mother'>>
				<<set $characters.vincent.quests.sanctuary_done = true>>
				<<set $characters.vincent.quests.sanctuary_done_day = $game.day - 20>>
				<<set $characters.blair.relationship = Math.max($characters.blair.relationship ?? 0, 95)>>
				<<unset $characters.blair.quests.mother_talk_day>>
				<<goto 'Blair [Event] - Her mother'>>
				<<script>>Dialog.close();<</script>>
			<</link>>
			<<link 'Event: Library - caught reading (needs an adult woman guest)'>>
				<<set _cheatLibIdx = $guests.findIndex(function (g) { return g.gender === 0 && setup.getAge(g) >= 18 && !(g.traits ?? []).includes('feral'); })>>
				<<if _cheatLibIdx >= 0>>
					<<set $tmpEvent = { id: _cheatLibIdx }>>
					<<set $guests[_cheatLibIdx].likesGuys = true>>
					<<goto 'Library [Event] - caught reading'>>
					<<script>>Dialog.close();<</script>>
				<</if>>
			<</link>>
			<<link 'Event: Library - she followed you (needs an adult woman guest)'>>
				<<set _cheatLibIdx = $guests.findIndex(function (g) { return g.gender === 0 && setup.getAge(g) >= 18 && !(g.traits ?? []).includes('feral'); })>>
				<<if _cheatLibIdx >= 0>>
					<<set $tmpEvent = { id: _cheatLibIdx }>>
					<<set $guests[_cheatLibIdx].likesGuys = true>>
					<<goto 'Library [Event] - she followed you'>>
					<<script>>Dialog.close();<</script>>
				<</if>>
			<</link>>
			<<link 'Event: Negan - She Remembers You'>>
				<<set $characters.negan.quests.barter_day = $characters.negan.quests.barter_day ?? ($game.day - 10)>>
				<<unset $characters.negan.quests.remembers_day>>
				<<goto 'Negan - She Remembers You'>>
				<<script>>Dialog.close();<</script>>
			<</link>>

			<<set _teachers = setup.filterNPCs($guests, {'skills_inc': ['teacher'], 'gender':0})[0]>>
			<<set _linkName = 'Event: Teaching outside'>>
			<<if !(_teachers ?? []).length>>
				<<set _linkName += ' (Will add guest with teacher skill)'>>
			<</if>>
			<<link _linkName>>
				<<if !(_teachers ?? []).length>>
					<<newgirl>>
					<<run $tmpGirl.skills.push('teacher')>>
					<<run $guests.push($tmpGirl)>>
				<</if>>
				<<goto 'Event - Youth district - teaching outside'>>
				<<script>>Dialog.close();<</script>>
			<</link>>
		</fieldset>
	<</if>>
</div>

<style>
 .cheatmenu .link-internal.macro-link {
 	display:block;
	padding-left: 20px;
 }
</style>


