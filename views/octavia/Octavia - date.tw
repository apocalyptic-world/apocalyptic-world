:: Octavia - date
<h1 class="ptitle">OCTAVIA</h1>
<br /><br />
<<octavia>>
    Where do you wanna go?
<</octavia>>
<br />
<<if recall($suppCode)>>
    <<link 'Nightclub'>>
	    <<set $player.companionsHome = $player.companions>>
		<<run setup.companions.clear()>>
		<<goto 'Octavia - date [nightclub]'>>
	<</link>>
<<else>>
	<div class="link-internal disabled" style="background: #ccc">
		Nightclub
		<<notPatreonIcon>>
	</div>
<</if>>
<<if !recall($suppCode)>>
	<div class="link-internal disabled" style="background: #ccc">
		Walk in the forest
		<<notPatreonIcon>>
	</div>
<<elseif timeBetween('08:00', '15:00')>>
	<<link 'Walk in the forest'>>
		<<set $player.companionsHome = $player.companions>>
		<<run setup.companions.clear()>>
		<<goto 'Octavia - date [forest walk]'>>
	<</link>>
<<else>>
	<div class="link-internal disabled" style="background: #ccc">
		Walk in the forest
	</div>
	<<linkdesc>>
		Only in the daytime (08:00 - 15:00)
	<</linkdesc>>
<</if>>
<<link 'Leave'>>
	<<set _dateBack = $tmpGirlBack ?? 'Guest house'>>
	<<goto `_dateBack`>>
<</link>>