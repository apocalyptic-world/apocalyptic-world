:: Octavia room [bg-guesthouse]
<h1 class="ptitle">OCTAVIA</h1>
<br /><br />

<<if $characters.octavia.quests.warriors_done_day && ($characters.octavia.quests.warriors_done_day + 3) < $game.day && !$characters.octavia.quests.emberclaw_ready_day>>
    <<goto 'Octavia \[Event\] - Emberclaw Ready'>>
<<else>>

<<set _octVisitWarrior = null>>
<<if $characters.octavia.visitWarriorResolvedId>>
	<<set _octVisitWarrior = ($characters.octavia.quests.warriors ?? []).find(w => w.id === $characters.octavia.visitWarriorResolvedId) ?? null>>
	<<if _octVisitWarrior>>
			<<if setup.percentageChance(75) || !settings.lesbiansEnabled>>
				You enter to find Octavia and <<=_octVisitWarrior.name>> hunched over a rough map spread across the table, voices low as they talk through plans for the Emberclaw encampment. They don't notice you at first — it's only when you step further into the room that Octavia glances up. Without a word she gives the warrior a small nod, and <<=setup.pronounceWhat(_octVisitWarrior)>> gathers the map and slips out, leaving the two of you alone.
			<<else>>
				
				<center>
					<<image 'places/octavia/octavia_warrior_bed.jpg'>>
				</center>
				<br />
				You step through the door and stop. Octavia is on the bed with <<=_octVisitWarrior.name>>, clearly not engaged in any sort of planning. The moment she catches your eye she gives you a mischievous wink and holds up a single finger. You wait as she turns her passionate attention back to her warrior. <br /><br />She finishes, looking quite satisfied, says something quiet to the warrior, and leaves <<=setup.pronounceWho(_octVisitWarrior)>> there on the bed as she slides off and strides over to you, not bothering with her clothes.
			<</if>>
			<br /><br />
	<</if>>
<</if>>

<<octavia>>
    Hey! How it's going?
<</octavia>>

<br /><br />

<<if $characters.octavia.quests.next_move && !$characters.octavia.quests.new_plan && ($characters.octavia.quests.next_move_day +5) < $game.day>>
    <<goto 'Octavia - new plan'>>
<<elseif $characters.octavia.quests.new_plan && !$characters.octavia.quests.new_plan2>>
    <<link 'About next plan'>>
        <<goto 'Octavia - new plan #2'>>
    <</link>>
<<elseif $characters.octavia.quests.new_plan2 && !$characters.octavia.quests.new_plan3 && $characters.octavia.quests.new_plan2_day < $game.day>>
    <<link 'Investigate new information'>>
        <<goto 'Octavia - investigation'>>
    <</link>>
<<elseif $characters.octavia.quests.new_plan3 && !$characters.octavia.quests.rebuild_tribe_day && ($characters.octavia.quests.new_plan3_day + 3) < $game.day>>
    <<goto 'Octavia [Event] - Rebuild the Emberclaw'>>
<</if>>
<<if $characters.octavia.quests.rebuild_tribe_day && !$characters.octavia.quests.emberclaw_ready_day && ($characters.octavia.quests.warriors ?? []).length < 5>>
    <<set _wLink = 'Send a warrior (' + ($characters.octavia.quests.warriors ?? []).length + '/5)'>>
    <<link `_wLink`>>
        <<goto 'Octavia - Send Warrior'>>
    <</link>>
<</if>>
<<link 'Approach her'>>
    <<set $charId = 'octavia'>>
	<<unset $slaveId, $guestId, $childId>>
	<<set $tmpGirl = $characters.octavia>>
    <<set $tmpGirl.location = 'bedroom'>>
	<<set $tmpGirlBack = 'Octavia room'>>
    <<set $tmpGirlViewBack = 'NPC view - character'>>
	<<goto 'NPC view - character'>>
<</link>>
<<set $tmpGirlBack = 'Octavia room'>>
<<if $characters.octavia.quests.canDate>>
    <<link 'Date'>>
        <<goto 'Octavia - date'>>
    <</link>>
<</if>>
<<if _octVisitWarrior>>
	<<link `'Approach warrior companion (' + _octVisitWarrior.name + ')'`>>
		<<set $warriorId = ($characters.octavia.quests.warriors ?? []).findIndex(w => w.id === $characters.octavia.visitWarriorResolvedId)>>
		<<set $tmpGirl = $characters.octavia.quests.warriors[$warriorId]>>
		<<set $tmpGirlBack = 'Octavia room'>>
		<<set $warriorViewActive = true>>
		<<unset $slaveId, $guestId, $charId, $childId>>
		<<goto 'Octavia - Warrior view'>>
	<</link>>
<</if>>
<<link 'Leave'>>
    <<goto 'Guest house'>>
<</link>>
<</if>>